/* ==================================================================
   CsvContainerCreatorWindow — All-in-one Style
   ================================================================== */

/* ===== CSS Variables (UE5 Color Palette) ===== */
:root {
    /* Primary Background Colors */
    --ue5-bg-darkest: #1a1a1a;
    --ue5-bg-dark: #1e1e1e;
    --ue5-bg-panel: #242424;
    --ue5-bg-element: #2a2a2a;
    --ue5-bg-hover: #333333;
    --ue5-bg-active: #3a3a3a;
    
    /* Accent Colors (UE5 Orange) */
    --ue5-accent-primary: #ff9500;
    --ue5-accent-secondary: #e68a00;
    --ue5-accent-glow: rgba(255, 149, 0, 0.15);
    --ue5-accent-border: rgba(255, 149, 0, 0.4);
    
    /* Border Colors */
    --ue5-border-dark: #0d0d0d;
    --ue5-border-subtle: #383838;
    --ue5-border-light: #454545;
    
    /* Text Colors */
    --ue5-text-primary: #e8e8e8;
    --ue5-text-secondary: #a0a0a0;
    --ue5-text-disabled: #666666;
    --ue5-text-highlight: #ffffff;
    
    /* Selection Colors */
    --ue5-selected-bg: #ff9500;
    --ue5-selected-text: #1a1a1a;
    --ue5-selected-hover: #ffaa33;
    
    /* Button Colors */
    --ue5-btn-bg: #3d3d3d;
    --ue5-btn-hover: #4a4a4a;
    --ue5-btn-active: #555555;
    --ue5-btn-primary-bg: #ff9500;
    --ue5-btn-primary-hover: #ffaa33;
    --ue5-btn-primary-active: #cc7700;
}

/* ===== Root Container ===== */
.ue5-root {
    background-color: #141414;
    color: var(--ue5-text-primary);
    font-size: 12px;
    -unity-font-style: normal;
    padding: 4px;
}

/* ===== Window Title ===== */
.window-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--ue5-text-highlight);
    margin-bottom: 8px;
    padding-left: 4px;
}

/* ===== Toolbar Panel ===== */
.toolbar-panel {
    background-color: #1e1e1e;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--ue5-accent-border);
    padding: 8px 12px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}

.toolbar-label {
    font-size: 11px;
    color: var(--ue5-text-secondary);
    margin-right: 8px;
    -unity-font-style: bold;
}

/* ===== Content ScrollView ===== */
.content-scroll {
    flex-grow: 1;
    background-color: transparent;
}

/* ===== Group Container ===== */
.group-container {
    background-color: #1e1e1e;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--ue5-accent-border);
    margin-bottom: 10px;
    overflow: hidden;
}

/* ===== Group Header ===== */
.group-header {
    flex-direction: row;
    align-items: center;
    background-color: #262626;
    padding: 6px 10px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue5-border-dark);
}

.group-title {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--ue5-text-highlight);
}

/* ===== Group Content ===== */
.group-content {
    padding: 6px;
}

/* ===== Item Row ===== */
.item-row {
    flex-direction: row;
    align-items: center;
    background-color: #242424;
    border-radius: 4px;
    padding: 4px 6px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: transparent;
}

.item-row:hover {
    background-color: #2e2e2e;
    border-color: var(--ue5-border-subtle);
}

/* ===== Item Icon ===== */
.item-icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ===== Item Name ===== */
.item-name {
    flex-grow: 1;
    font-size: 11px;
    color: var(--ue5-text-primary);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ===== Action Button ===== */
.action-btn {
    height: 24px;
    min-height: 24px;
    min-width: 28px;
    font-size: 11px;
    background-color: var(--ue5-btn-bg);
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-radius: 3px;
    color: var(--ue5-text-primary);
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 2px;
    flex-shrink: 0;
}

.action-btn:hover {
    background-color: var(--ue5-btn-hover);
    color: var(--ue5-text-highlight);
}

.action-btn:active {
    background-color: var(--ue5-btn-active);
}

/* ===== Primary Button ===== */
.primary-btn {
    height: 26px;
    min-height: 26px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: var(--ue5-btn-primary-bg);
    color: var(--ue5-selected-text);
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--ue5-accent-secondary);
    padding-left: 12px;
    padding-right: 12px;
}

.primary-btn:hover {
    background-color: var(--ue5-btn-primary-hover);
}

.primary-btn:active {
    background-color: var(--ue5-btn-primary-active);
}

/* ===== Text Field ===== */
.ue5-text-field {
    flex-grow: 1;
    margin-right: 8px;
}

.ue5-text-field > .unity-text-field__input {
    background-color: var(--ue5-bg-darkest);
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
    border-radius: 3px;
    color: var(--ue5-text-primary);
    padding: 4px 8px;
    font-size: 11px;
    min-height: 24px;
}

.ue5-text-field > .unity-text-field__input:hover {
    border-color: var(--ue5-border-light);
}

.ue5-text-field > .unity-text-field__input:focus {
    border-color: var(--ue5-accent-primary);
}

/* ===== Help Box ===== */
.help-box {
    background-color: rgba(255, 149, 0, 0.1);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 149, 0, 0.3);
    padding: 10px 12px;
    margin: 8px 0;
}

.help-box-text {
    font-size: 11px;
    color: var(--ue5-text-secondary);
    -unity-text-align: middle-center;
}

/* ===== Empty State ===== */
.empty-state {
    padding: 12px;
    -unity-text-align: middle-center;
}

.empty-state-text {
    font-size: 11px;
    color: #808080;
    -unity-font-style: italic;
}

/* ===== Badge ===== */
.badge {
    background-color: var(--ue5-accent-primary);
    color: var(--ue5-selected-text);
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 8px;
    margin-left: 6px;
}

.badge-build {
    background-color: #4a9f4a;
}

/* ===== Scrollbars - UE5 Slim Style ===== */
.unity-scroller {
    background-color: transparent;
}

.unity-scroller--vertical {
    width: 10px;
}

.unity-base-slider__dragger {
    background-color: #4a4a4a;
    border-radius: 2px;
    border-width: 0;
    margin: 2px;
}

.unity-base-slider__dragger:hover {
    background-color: #5a5a5a;
}

.unity-base-slider__dragger:active {
    background-color: var(--ue5-accent-primary);
}

/* ==================================================================
   Local Overrides / Window Specific Styles
   ================================================================== */

/* ===== Main Split Layout ===== */
.csv-main-container {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* ===== Left Panel (type list) ===== */
.csv-left-panel {
    width: 320px;
    min-width: 280px;
    max-width: 450px;
    display: flex;
    flex-direction: column;
    margin-right: 6px;
}

/* ===== Right Panel (detail) ===== */
.csv-right-panel {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

/* ===== Selected Item Highlight ===== */
.csv-item-selected {
    background-color: rgba(255, 149, 0, 0.15);
    border-color: var(--ue5-accent-border);
}

.csv-item-selected:hover {
    background-color: rgba(255, 149, 0, 0.22);
}

/* ===== Namespace Badge (small pill) ===== */
.csv-ns-badge {
    font-size: 9px;
    color: var(--ue5-text-disabled);
    background-color: #2a2a2a;
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
    border-radius: 6px;
    padding-left: 5px;
    padding-right: 5px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ===== Detail Info Row ===== */
.csv-info-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
    padding: 6px 8px;
    background-color: #222222;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
}

.csv-info-label {
    width: 90px;
    min-width: 90px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ue5-text-disabled);
    -unity-text-align: middle-left;
}

.csv-info-value {
    flex-grow: 1;
    font-size: 11px;
    color: var(--ue5-text-primary);
    white-space: normal;
    overflow: hidden;
}

/* ===== Separator ===== */
.csv-separator {
    height: 1px;
    background-color: var(--ue5-border-subtle);
    margin-top: 8px;
    margin-bottom: 12px;
}

/* ===== Create Asset Button (full-width override) ===== */
.csv-create-btn {
    align-self: stretch;
    height: 36px;
    font-size: 13px;
    margin-top: 0;
}

/* ===== Asset path label in Existing Assets rows ===== */
.csv-asset-path {
    font-size: 10px;
    color: var(--ue5-text-disabled);
    -unity-text-align: middle-right;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
    margin-right: 4px;
}

/* ===== Fields Section Title ===== */
.csv-fields-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ue5-text-disabled);
    letter-spacing: 1px;
    margin-top: 10px;
    margin-bottom: 4px;
    padding-left: 2px;
}

/* ===== Field Row ===== */
.csv-field-row {
    flex-direction: row;
    align-items: center;
    background-color: #1e1e1e;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
    padding: 4px 8px;
    margin-bottom: 3px;
}

.csv-field-row:hover {
    background-color: #262626;
    border-color: var(--ue5-border-light);
}

/* Type keyword (int, string, …) */
.csv-field-type {
    font-size: 11px;
    color: #7ec8e3;         /* blue-ish, like VS Code type color */
    -unity-font-style: bold;
    margin-right: 6px;
    min-width: 48px;
}

/* Member name */
.csv-field-name {
    font-size: 11px;
    color: var(--ue5-text-primary);
    flex-grow: 1;
}

/* Arrow between member name and column name */
.csv-field-arrow {
    font-size: 11px;
    color: var(--ue5-text-disabled);
    margin-left: 4px;
    margin-right: 4px;
}

/* CSV column name string */
.csv-field-colname {
    font-size: 11px;
    color: #c3e88d;         /* green-ish, like VS Code string color */
    margin-right: 4px;
}

/* ===== Field Badges ===== */
.csv-field-badge {
    font-size: 9px;
    border-radius: 6px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-left: 3px;
    -unity-text-align: middle-center;
}

/* optional badge — warm amber */
.csv-field-badge--optional {
    background-color: rgba(255, 193, 7, 0.15);
    border-width: 1px;
    border-color: rgba(255, 193, 7, 0.4);
    color: #ffc107;
}

/* no-column badge — dim */
.csv-field-badge--none {
    background-color: #2a2a2a;
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
    color: var(--ue5-text-disabled);
}

/* FinalParse badge — teal */
.csv-field-badge--final {
    background-color: rgba(0, 188, 212, 0.15);
    border-width: 1px;
    border-color: rgba(0, 188, 212, 0.4);
    color: #00bcd4;
}

/* ===== Inspector Meta Block (InspectorTitle + InspectorIntro) ===== */
.csv-meta-block {
    margin-bottom: 10px;
    padding: 8px 4px 4px 4px;
}

/* Large centered title (mirrors InspectorTitleAttribute) */
.csv-meta-title {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--ue5-accent-primary);
    /* font-size is set inline from titleAttr.FontSize / 2 */
    margin-bottom: 6px;
}

/* Intro / description text (mirrors InspectorIntroAttribute) */
.csv-meta-intro {
    font-size: 11px;
    color: var(--ue5-text-secondary);
    white-space: normal;
    padding: 4px 2px;
    margin-bottom: 6px;
}

/* Divider after title — solid gray */
.csv-meta-divider {
    height: 1px;
    background-color: #707070;
    margin-bottom: 8px;
}

/* Divider after intro — lighter */
.csv-meta-divider--light {
    background-color: #444444;
}