/* ==================================================================
   AxuKitBox V2 - UE5 Inspired Theme
   Inspired by Unreal Engine 5 Editor Interface
   ================================================================== */

/* ===== CSS Variables (UE5 Color Palette) ===== */
:root {
    --sidebar-width: 220px;
    --header-height: 44px;
    
    /* Primary Background Colors */
    --ue5-bg-darkest: #141414;
    --ue5-bg-dark: #1a1a1a;
    --ue5-bg-panel: #1e1e1e;
    --ue5-bg-element: #262626;
    --ue5-bg-hover: #333333;
    --ue5-bg-active: #3a3a3a;
    
    /* Accent Colors (UE5 Orange) */
    --ue5-accent-primary: #ff9500;
    --ue5-accent-secondary: #e68a00;
    --ue5-accent-glow: rgba(255, 149, 0, 0.15);
    --ue5-accent-border: rgba(255, 149, 0, 0.4);
    
    /* Border Colors */
    --ue5-border-dark: #0d0d0d;
    --ue5-border-subtle: #383838;
    --ue5-border-light: #454545;
    
    /* Text Colors */
    --ue5-text-primary: #e8e8e8;
    --ue5-text-secondary: #a0a0a0;
    --ue5-text-disabled: #666666;
    --ue5-text-highlight: #ffffff;
    
    /* Selection Colors */
    --ue5-selected-bg: #ff9500;
    --ue5-selected-text: #1a1a1a;
    --ue5-selected-hover: #ffaa33;
    
    /* Button Colors */
    --ue5-btn-bg: #3d3d3d;
    --ue5-btn-hover: #4a4a4a;
    --ue5-btn-active: #555555;
    --ue5-btn-primary-bg: #ff9500;
    --ue5-btn-primary-hover: #ffaa33;
}

/* ===== Root Container ===== */
#root-container {
    flex-direction: row;
    height: 100%;
    background-color: var(--ue5-bg-darkest);
    color: var(--ue5-text-primary);
    font-size: 13px;
}

/* ===== Sidebar Styling ===== */
#sidebar {
    width: var(--sidebar-width);
    background-color: var(--ue5-bg-dark);
    border-right-width: 1px;
    border-right-color: var(--ue5-border-dark);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

#sidebar-header {
    height: var(--header-height);
    background-color: var(--ue5-bg-darkest);
    justify-content: center;
    padding-left: 15px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue5-border-dark);
}

#sidebar-header-label {
    -unity-font-style: bold;
    color: var(--ue5-accent-primary);
    font-size: 14px;
    letter-spacing: 0.5px;
}

#nav-scroll-view {
    flex-grow: 1;
}

#nav-container {
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 10px;
    padding-bottom: 10px;
}

#sidebar-footer {
    padding: 12px;
    background-color: var(--ue5-bg-darkest);
    border-top-width: 1px;
    border-top-color: var(--ue5-border-dark);
}

#refresh-button {
    height: 32px;
    border-radius: 4px;
    background-color: var(--ue5-btn-bg);
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-top-color: var(--ue5-border-light);
    color: var(--ue5-text-primary);
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

#refresh-button:hover {
    background-color: var(--ue5-btn-hover);
    color: var(--ue5-text-highlight);
}

#refresh-button:active {
    background-color: var(--ue5-btn-active);
}

/* ===== Main Content Styling ===== */
#main-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--ue5-bg-panel);
}

#content-header {
    height: var(--header-height);
    background-color: var(--ue5-bg-element);
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    padding-left: 20px;
    padding-right: 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue5-border-dark);
}

#content-title {
    -unity-font-style: bold;
    font-size: 16px;
    color: var(--ue5-text-highlight);
    letter-spacing: 0.5px;
}

#content-body {
    flex-grow: 1;
    padding: 0;
}

#content-scroll-view {
    flex-grow: 1;
}

#content-container {
    padding: 0;
}

/* ===== Group Foldout Styling ===== */
.group-foldout {
    margin: 4px 0;
    color: var(--ue5-text-primary);
}

.group-foldout > .unity-foldout__toggle {
    margin-left: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: transparent;
    border-radius: 3px;
}

.group-foldout > .unity-foldout__toggle:hover {
    background-color: var(--ue5-bg-hover);
}

.group-foldout > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
    font-size: 12px;
    color: var(--ue5-accent-primary);
}

/* ===== Navigation Item Styling ===== */
.nav-item {
    margin: 2px 4px 2px 16px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-radius: 3px;
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
    color: var(--ue5-text-secondary);
    font-size: 12px;
    transition-duration: 0.12s;
}

.nav-item:hover {
    background-color: var(--ue5-bg-hover);
    color: var(--ue5-text-highlight);
}

.nav-item--selected {
    background-color: var(--ue5-selected-bg);
    color: var(--ue5-selected-text);
    -unity-font-style: bold;
    border-left-width: 0;
}

.nav-item--selected:hover {
    background-color: var(--ue5-selected-hover);
    color: var(--ue5-selected-text);
}

/* ===== Scrollbars - UE5 Slim Style ===== */
.unity-scroller {
    background-color: transparent;
}

.unity-scroller--vertical {
    width: 10px;
}

.unity-scroller--horizontal {
    height: 10px;
}

.unity-scroller__slider {
    background-color: var(--ue5-bg-dark);
    border-radius: 0;
    margin: 0;
}

.unity-base-slider__dragger {
    background-color: #4a4a4a;
    border-radius: 2px;
    border-width: 0;
    margin: 2px;
}

.unity-base-slider__dragger:hover {
    background-color: #5a5a5a;
}

.unity-base-slider__dragger:active {
    background-color: var(--ue5-accent-primary);
}

/* ========================================
   Common Page Styles
   ======================================== */

.page-container {
    padding: 20px;
    flex-grow: 1;
}

.page-header {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: var(--ue5-text-highlight);
}

.page-subheader {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: var(--ue5-text-primary);
}

.page-hint {
    color: var(--ue5-text-secondary);
    margin-bottom: 20px;
    white-space: normal;
    font-size: 12px;
}

.section-header {
    margin-top: 30px;
    margin-bottom: 5px;
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--ue5-accent-primary);
}

/* ========================================
   Buttons - UE5 Style
   ======================================== */

.btn-primary {
    height: 40px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: var(--ue5-btn-primary-bg);
    color: var(--ue5-selected-text);
    border-width: 1px;
    border-color: var(--ue5-accent-secondary);
    border-top-color: var(--ue5-selected-hover);
    border-radius: 4px;
    transition-duration: 0.12s;
}

.btn-primary:hover {
    background-color: var(--ue5-btn-primary-hover);
}

.btn-primary:active {
    background-color: var(--ue5-accent-secondary);
}

.btn-primary:disabled {
    background-color: #2a2a2a;
    color: var(--ue5-text-disabled);
    border-color: #1a1a1a;
}

.btn-success {
    height: 36px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: #2a5a2a;
    color: #aaffaa;
    border-width: 1px;
    border-color: #3a7a3a;
    border-radius: 4px;
    transition-duration: 0.12s;
}

.btn-success:hover {
    background-color: #3a7a3a;
    color: #ccffcc;
}

.btn-danger {
    height: 36px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: #5a2a2a;
    color: #ffaaaa;
    border-width: 1px;
    border-color: #7a3a3a;
    border-radius: 4px;
    transition-duration: 0.12s;
}

.btn-danger:hover {
    background-color: #7a3a3a;
    color: #ffcccc;
}

.btn-secondary {
    background-color: var(--ue5-btn-bg);
    color: var(--ue5-text-primary);
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-top-color: var(--ue5-border-light);
    border-radius: 3px;
    transition-duration: 0.12s;
}

.btn-secondary:hover {
    background-color: var(--ue5-btn-hover);
    color: var(--ue5-text-highlight);
}

.btn-small {
    width: 24px;
    height: 24px;
    background-color: transparent;
    border-width: 0;
}

.btn-small:hover {
    background-color: var(--ue5-bg-hover);
}

/* ========================================
   Containers & Boxes
   ======================================== */

.config-box {
    background-color: var(--ue5-bg-element);
    padding: 15px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--ue5-accent-border);
    margin-bottom: 20px;
}

.card {
    background-color: var(--ue5-bg-element);
    padding: 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
}

.slot-container {
    width: 44%;
    background-color: var(--ue5-bg-element);
    padding: 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
}

.slot-title {
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: var(--ue5-accent-primary);
}

/* ========================================
   Toolbars
   ======================================== */

.toolbar {
    flex-direction: row;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: var(--ue5-bg-element);
    border-bottom-width: 1px;
    border-bottom-color: var(--ue5-border-dark);
    align-items: center;
}

.toolbar-spacer {
    flex-grow: 1;
}

/* ========================================
   Lists & Views
   ======================================== */

.log-view {
    flex-grow: 1;
    min-height: 150px;
    background-color: var(--ue5-bg-darkest);
    padding: 8px;
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-radius: 4px;
}

.asset-list {
    flex-grow: 1;
    min-height: 250px;
    background-color: var(--ue5-bg-dark);
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-radius: 4px;
}

.list-item-row {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

/* ========================================
   Layout Helpers
   ======================================== */

.row {
    flex-direction: row;
}

.row-space-between {
    flex-direction: row;
    justify-content: space-between;
}

.row-center {
    flex-direction: row;
    align-items: center;
}

.flex-grow {
    flex-grow: 1;
}

/* ========================================
   Text Styles
   ======================================== */

.text-secondary {
    color: var(--ue5-text-secondary);
}

.text-muted {
    color: var(--ue5-text-disabled);
    font-size: 11px;
}

.text-bold {
    -unity-font-style: bold;
}

/* ========================================
   Spacing Utilities
   ======================================== */

.mb-5 { margin-bottom: 5px; }
.mb-10 { margin-bottom: 10px; }
.mb-15 { margin-bottom: 15px; }
.mb-20 { margin-bottom: 20px; }
.mb-25 { margin-bottom: 25px; }
.mb-30 { margin-bottom: 30px; }

.mt-5 { margin-top: 5px; }
.mt-10 { margin-top: 10px; }
.mt-20 { margin-top: 20px; }
.mt-30 { margin-top: 30px; }

/* ========================================
   Welcome Page Specific
   ======================================== */

.welcome-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 40px;
    background-color: var(--ue5-bg-panel);
}

.welcome-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--ue5-accent-primary);
    margin-bottom: 10px;
}

.welcome-subtitle {
    font-size: 16px;
    color: var(--ue5-text-secondary);
    margin-bottom: 30px;
}

.feature-card {
    width: 250px;
    height: 100px;
    margin: 10px;
    padding: 15px;
    background-color: var(--ue5-bg-element);
    border-left-width: 4px;
    border-left-color: var(--ue5-accent-primary);
    border-radius: 4px;
    transition-duration: 0.15s;
}

.feature-card:hover {
    background-color: var(--ue5-bg-hover);
    border-left-color: var(--ue5-selected-hover);
}

.feature-card-title {
    -unity-font-style: bold;
    font-size: 14px;
    color: var(--ue5-text-highlight);
}

.feature-card-desc {
    margin-top: 5px;
    font-size: 11px;
    color: var(--ue5-text-secondary);
    white-space: normal;
}

/* ========================================
   Scene Jump Specific
   ======================================== */

.scene-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue5-border-dark);
    transition-duration: 0.1s;
}

.scene-row:hover {
    background-color: var(--ue5-bg-hover);
}

/* ========================================
   Symbol Page Specific
   ======================================== */

.symbol-list-panel {
    width: 220px;
    border-right-width: 1px;
    border-right-color: var(--ue5-border-dark);
    background-color: var(--ue5-bg-dark);
}

.symbol-list-header {
    padding: 10px;
    -unity-font-style: bold;
    background-color: var(--ue5-bg-element);
    color: var(--ue5-accent-primary);
}

.symbol-detail-area {
    flex-grow: 1;
    padding: 20px;
    background-color: var(--ue5-bg-panel);
}

.symbol-detail-title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    color: var(--ue5-text-highlight);
}

.symbol-detail-desc {
    white-space: normal;
    color: var(--ue5-text-secondary);
    font-size: 13px;
    margin-bottom: 30px;
}

.symbol-status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

/* ========================================
   SelectionToCsv Page Specific
   ======================================== */
   
.column-selection-container {
    margin-top: 15px;
    margin-bottom: 15px;
    background-color: var(--ue5-bg-element);
    padding: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--ue5-accent-border);
}

.column-toggle-btn {
    margin-right: 6px;
    margin-bottom: 6px;
    height: 26px;
    border-radius: 13px;
    background-color: var(--ue5-btn-bg);
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
    color: var(--ue5-text-secondary);
    transition-duration: 0.12s;
}

.column-toggle-btn:hover {
    background-color: var(--ue5-btn-hover);
    color: var(--ue5-text-highlight);
}

.column-toggle-btn.active {
    background-color: var(--ue5-accent-primary);
    border-color: var(--ue5-accent-secondary);
    color: var(--ue5-selected-text);
    -unity-font-style: bold;
}

.column-toggle-btn.active:hover {
    background-color: var(--ue5-selected-hover);
}

.helper-btn-row {
    flex-direction: row;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--ue5-border-subtle);
    padding-top: 8px;
}

.helper-text-btn {
    background-color: transparent;
    border-width: 0;
    color: var(--ue5-accent-primary);
    margin-right: 10px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.helper-text-btn:hover {
    color: var(--ue5-selected-hover);
    background-color: var(--ue5-bg-hover);
    border-radius: 4px;
}

.options-row {
    flex-direction: row;
    margin-bottom: 15px;
    padding-left: 5px;
}

.option-toggle {
    margin-right: 25px;
}

.asset-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

.asset-type-label {
    color: var(--ue5-text-disabled);
    font-size: 11px;
}

.browse-button {
    width: 70px;
}

/* ========================================
   CSV Editor Page Specific
   ======================================== */

.csv-scroll-view {
    flex-grow: 1;
    background-color: var(--ue5-bg-dark);
}

.csv-grid-container {
    padding: 2px;
}

.csv-row {
    flex-direction: row;
}

.csv-cell {
    width: 120px;
    margin: 0;
}

.csv-cell-header {
    -unity-font-style: bold;
    background-color: #2d4a2d;
}

/* ========================================
   Drag and Drop Overlay
   ======================================== */

.drag-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 149, 0, 0.2);
    border-width: 3px;
    border-color: var(--ue5-accent-primary);
    align-items: center;
    justify-content: center;
    display: none;
}

.drag-hint-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--ue5-text-highlight);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

/* ========================================
   Input Fields - UE5 Style
   ======================================== */

.unity-text-field > .unity-base-field__input,
.unity-integer-field > .unity-base-field__input,
.unity-float-field > .unity-base-field__input {
    background-color: var(--ue5-bg-darkest);
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
    border-radius: 3px;
    color: var(--ue5-text-primary);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.unity-text-field > .unity-base-field__input:focus,
.unity-integer-field > .unity-base-field__input:focus,
.unity-float-field > .unity-base-field__input:focus {
    border-color: var(--ue5-accent-primary);
}

.unity-enum-field > .unity-base-field__input {
    background-color: var(--ue5-bg-element);
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
    border-radius: 3px;
    color: var(--ue5-text-primary);
}

.unity-enum-field > .unity-base-field__input:hover {
    border-color: var(--ue5-border-light);
}

/* Toggle Checkbox - UE5 Style */
.unity-toggle .unity-toggle__checkmark {
    background-color: var(--ue5-bg-darkest);
    border-width: 1px;
    border-color: var(--ue5-border-subtle);
    border-radius: 2px;
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--ue5-accent-primary);
    border-color: var(--ue5-accent-secondary);
}
