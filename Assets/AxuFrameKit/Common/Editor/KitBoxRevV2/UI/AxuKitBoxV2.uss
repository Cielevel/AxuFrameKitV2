:root {
    --sidebar-width: 220px;
    --sidebar-bg: #222222;
    --main-bg: #2a2a2a;
    --accent-color: #3498db;
    --accent-hover: #2980b9;
    --text-color: #e0e0e0;
    --text-secondary: #aaaaaa;
    --header-height: 44px;
    --border-color: #111111;
    --selected-bg: #3d3d3d;
}

#root-container {
    flex-direction: row;
    height: 100%;
    background-color: var(--main-bg);
    color: var(--text-color);
    font-size: 13px;
}

/* Sidebar Styling */
#sidebar {
    width: var(--sidebar-width);
    background-color: var(--sidebar-bg);
    border-right-width: 1px;
    border-right-color: var(--border-color);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

#sidebar-header {
    height: var(--header-height);
    background-color: #1a1a1a;
    justify-content: center;
    padding-left: 15px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
}

#sidebar-header-label {
    -unity-font-style: bold;
    color: var(--accent-color);
    font-size: 14px;
    letter-spacing: 1px;
}

#nav-scroll-view {
    flex-grow: 1;
}

#nav-container {
    padding: 10px 5px;
}

#sidebar-footer {
    padding: 12px;
    background-color: #1a1a1a;
    border-top-width: 1px;
    border-top-color: var(--border-color);
}

#refresh-button {
    height: 32px;
    border-radius: 6px;
    background-color: #333;
    border-width: 0;
    color: white;
    transition-property: background-color, scale;
    transition-duration: 0.2s;
}

#refresh-button:hover {
    background-color: #444;
}

#refresh-button:active {
    background-color: #222;
    scale: 0.98;
}

/* Main Content Styling */
#main-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

#content-header {
    height: var(--header-height);
    background-color: #252525;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    padding: 0 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
}

#content-title {
    -unity-font-style: bold;
    font-size: 18px;
    color: #ffffff;
}

#content-body {
    flex-grow: 1;
    padding: 0;
}

#content-scroll-view {
    flex-grow: 1;
}

#content-container {
    padding: 0;
}

/* Group & Page button styles */
.group-foldout {
    margin: 4px 0;
    color: #eeeeee;
}

.group-foldout > .unity-foldout__toggle {
    margin-left: 0;
    padding: 5px 0;
    background-color: transparent;
}

.group-foldout > .unity-foldout__toggle:hover {
    background-color: #2a2a2a;
}

.group-foldout > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
    font-size: 13px;
}

.nav-item {
    margin: 2px 4px 2px 20px;
    padding: 6px 12px;
    border-radius: 4px;
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
    color: var(--text-secondary);
    transition-property: background-color, color, translate;
    transition-duration: 0.2s;
}

.nav-item:hover {
    background-color: #333;
    color: white;
    translate: 2px 0;
}

.nav-item--selected {
    background-color: var(--accent-color);
    color: white;
    -unity-font-style: bold;
}

.nav-item--selected:hover {
    background-color: var(--accent-hover);
}

/* ========================================
   Common Page Styles
   ======================================== */

/* Page Container */
.page-container {
    padding: 20px;
    flex-grow: 1;
}

/* Headers */
.page-header {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: #ffffff;
}

.page-subheader {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: #e0e0e0;
}

.page-hint {
    color: #999999;
    margin-bottom: 20px;
    white-space: normal;
    font-size: 13px;
}

/* Section Headers */
.section-header {
    margin-top: 30px;
    margin-bottom: 5px;
    -unity-font-style: bold;
    font-size: 14px;
}

/* ========================================
   Buttons
   ======================================== */

/* Primary Action Button */
.btn-primary {
    height: 45px;
    font-size: 15px;
    -unity-font-style: bold;
    background-color: #3498db;
    color: white;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.btn-primary:hover {
    background-color: #2980b9;
}

.btn-primary:disabled {
    background-color: #555555;
    color: #888888;
}

/* Success Button */
.btn-success {
    height: 40px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #2ecc71;
    color: white;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.btn-success:hover {
    background-color: #27ae60;
}

/* Danger Button */
.btn-danger {
    height: 40px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #e74c3c;
    color: white;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.btn-danger:hover {
    background-color: #c0392b;
}

/* Secondary Button */
.btn-secondary {
    background-color: transparent;
    color: #e0e0e0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.btn-secondary:hover {
    background-color: #333333;
}

/* Small Button */
.btn-small {
    width: 24px;
    height: 24px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* ========================================
   Containers & Boxes
   ======================================== */

/* Config Box */
.config-box {
    background-color: #333333;
    padding: 15px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-bottom: 20px;
}

/* Card Container */
.card {
    background-color: #383838;
    padding: 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Slot Container (for object fields) */
.slot-container {
    width: 44%;
    background-color: #383838;
    padding: 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.slot-title {
    -unity-font-style: bold;
    margin-bottom: 8px;
}

/* ========================================
   Toolbars
   ======================================== */

.toolbar {
    flex-direction: row;
    padding: 8px 10px;
    background-color: #2e2e2e;
    border-bottom-width: 1px;
    border-bottom-color: #1a1a1a;
    align-items: center;
}

.toolbar-spacer {
    flex-grow: 1;
}

/* ========================================
   Lists & Views
   ======================================== */

/* Log View */
.log-view {
    flex-grow: 1;
    min-height: 150px;
    background-color: #1e1e1e;
    padding: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #1a1a1a;
    border-right-color: #1a1a1a;
    border-top-color: #1a1a1a;
    border-bottom-color: #1a1a1a;
}

/* Asset List */
.asset-list {
    flex-grow: 1;
    min-height: 250px;
    background-color: #262626;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #1a1a1a;
    border-right-color: #1a1a1a;
    border-top-color: #1a1a1a;
    border-bottom-color: #1a1a1a;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* List Item Row */
.list-item-row {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

/* ========================================
   Layout Helpers
   ======================================== */

.row {
    flex-direction: row;
}

.row-space-between {
    flex-direction: row;
    justify-content: space-between;
}

.row-center {
    flex-direction: row;
    align-items: center;
}

.flex-grow {
    flex-grow: 1;
}

/* ========================================
   Text Styles
   ======================================== */

.text-secondary {
    color: #999999;
}

.text-muted {
    color: #666666;
    font-size: 11px;
}

.text-bold {
    -unity-font-style: bold;
}

/* ========================================
   Spacing Utilities
   ======================================== */

.mb-5 { margin-bottom: 5px; }
.mb-10 { margin-bottom: 10px; }
.mb-15 { margin-bottom: 15px; }
.mb-20 { margin-bottom: 20px; }
.mb-25 { margin-bottom: 25px; }
.mb-30 { margin-bottom: 30px; }

.mt-5 { margin-top: 5px; }
.mt-10 { margin-top: 10px; }
.mt-20 { margin-top: 20px; }
.mt-30 { margin-top: 30px; }

/* ========================================
   Welcome Page Specific
   ======================================== */

.welcome-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 40px;
}

.welcome-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: #4fa8db;
    margin-bottom: 10px;
}

.welcome-subtitle {
    font-size: 18px;
    color: #b0b0b0;
    margin-bottom: 30px;
}

.feature-card {
    width: 250px;
    height: 100px;
    margin: 10px;
    padding: 15px;
    background-color: #2e2e2e;
    border-left-width: 4px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

.feature-card-title {
    -unity-font-style: bold;
    font-size: 15px;
    color: white;
}

.feature-card-desc {
    margin-top: 5px;
    font-size: 12px;
    color: #b0b0b0;
    white-space: normal;
}

/* ========================================
   Scene Jump Specific
   ======================================== */

.scene-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(32, 32, 32, 0.3);
}

/* ========================================
   Symbol Page Specific
   ======================================== */

.symbol-list-panel {
    width: 220px;
    border-right-width: 1px;
    border-right-color: #262626;
}

.symbol-list-header {
    padding: 10px;
    -unity-font-style: bold;
    background-color: #2e2e2e;
}

.symbol-detail-area {
    flex-grow: 1;
    padding: 20px;
}

.symbol-detail-title {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.symbol-detail-desc {
    white-space: normal;
    color: #b0b0b0;
    font-size: 14px;
    margin-bottom: 30px;
}

.symbol-status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

/* ========================================
   SelectionToCsv Page Specific
   ======================================== */
   
.column-selection-container {
    margin-top: 15px;
    margin-bottom: 15px;
    background-color: #2b2b2b;
    padding: 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #1a1a1a;
}

.column-toggle-btn {
    margin-right: 6px;
    margin-bottom: 6px;
    height: 26px;
    border-radius: 13px; /* Pill shape */
    background-color: #383838;
    border-width: 1px;
    border-color: #444;
    color: #aeaeae;
    transition-duration: 0.15s;
}

.column-toggle-btn:hover {
    background-color: #484848;
    color: white;
}

.column-toggle-btn.active {
    background-color: #2ecc71;
    border-color: #27ae60;
    color: white;
    -unity-font-style: bold;
}

.column-toggle-btn.active:hover {
    background-color: #27ae60;
}

.helper-btn-row {
    flex-direction: row;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: #3e3e3e;
    padding-top: 8px;
}

.helper-text-btn {
    background-color: transparent;
    border-width: 0;
    color: #3498db;
    margin-right: 10px;
    cursor: link; /* if supported, else just visual */
    padding: 2px 5px;
}

.helper-text-btn:hover {
    color: #5dade2;
    background-color: #333;
    border-radius: 4px;
}

.options-row {
    flex-direction: row;
    margin-bottom: 15px;
    padding-left: 5px;
}

.option-toggle {
    margin-right: 25px;
}

.asset-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

.asset-type-label {
    color: #808080;
    font-size: 11px;
}

.browse-button {
    width: 70px;
}

/* ========================================
   CSV Editor Page Specific
   ======================================== */

.csv-scroll-view {
    flex-grow: 1;
    background-color: #262626;
}

.csv-grid-container {
    padding: 2px;
}

.csv-row {
    flex-direction: row;
}

.csv-cell {
    width: 120px;
    margin: 0;
}

.csv-cell-header {
    -unity-font-style: bold;
    background-color: #2d4a2d;
}

/* Drag and Drop Overlay */
.drag-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(52, 152, 219, 0.3);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: #4fa8db;
    border-right-color: #4fa8db;
    border-top-color: #4fa8db;
    border-bottom-color: #4fa8db;
    align-items: center;
    justify-content: center;
    display: none;
}

.drag-hint-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}
