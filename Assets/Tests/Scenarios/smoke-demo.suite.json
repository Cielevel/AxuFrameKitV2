{
  "schema": "axu-suite/1",
  "id": "smoke-demo",
  "title": "smoke 能力演示（目录扫描 TestAndSample 全部场景）",
  "scenarios": [
    {
      "schema": "axu-scenario/1",
      "id": "smoke.testandsample",
      "capability": "smoke",
      "title": "TestAndSample 冒烟矩阵（进得去 / 耗时 / 错误数 / 截图）",
      "params": {
        "source": "directory",
        "directory": "Assets/TestAndSample",
        "stabilitySeconds": 1,
        "stabilityFrames": 10,
        "screenshot": true
      },
      "budgets": [
        { "metric": "smoke.loadFailed.total", "op": "==", "value": 0 },
        { "metric": "smoke.errors.total", "op": "<=", "value": 0, "severity": "warn" }
      ]
    }
  ],
  "settings": {
    "stopOnFailure": false,
    "warnAsFail": false,
    "scenarioTimeoutSec": 900
  }
}
