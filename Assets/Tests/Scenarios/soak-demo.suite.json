{
  "schema": "axu-suite/1",
  "id": "soak-demo",
  "title": "soak 能力演示（当前场景采样 10 分钟，不自动驱动游玩）",
  "scenarios": [
    {
      "schema": "axu-scenario/1",
      "id": "soak.demo",
      "capability": "soak",
      "title": "当前场景 10 分钟采样（泄漏斜率 + FPS 衰减判定）",
      "params": {
        "durationMinutes": 10,
        "sampleIntervalSec": 30,
        "flushEveryMinutes": 2,
        "screenshotEveryMinutes": 3,
        "leakSlopeMBPerMin": 5,
        "fpsDecayPercent": 15
      },
      "budgets": [
        { "metric": "memory.allocatedMax", "op": "<=", "value": 16384, "unit": "MB" }
      ]
    }
  ],
  "settings": {
    "stopOnFailure": false,
    "warnAsFail": false,
    "scenarioTimeoutSec": 900
  }
}
