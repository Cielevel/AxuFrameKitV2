/* ==================================================================
   AxuTestRunner window tokens (independent copy, no reference to
   AxuFrameKit's AxuKitTokens.uss — values mirror its UE5 dark theme).
   ------------------------------------------------------------------
   本文件 = token 层 + 窗口组件层合一。色值取自框架包 AxuKitTokens.uss
   的 .theme-ue5 意象（bg #141414 / surface #1e1e1e / accent #ff9500 /
   ok #5cb85c / warn #ffc107 / bad #e05252），但完全独立维护：
   本包不引用、也不依赖 AxuFrameKit.Editor 程序集。
   USS 能力边界：无 box-shadow —— 层级感靠 surface 分层 + hairline 边线。
   ================================================================== */

/* ===== Tokens (UE5 dark, mirrored) ===== */
.axu-theme-ue5 {
    --ax-bg: #141414;
    --ax-surface: #1e1e1e;
    --ax-surface-2: #262626;
    --ax-hover: #323232;
    --ax-line: #262626;
    --ax-line-2: #3a3a3a;
    --ax-text: #e8e8e8;
    --ax-text-2: #a0a0a0;
    --ax-text-3: #6e6e6e;
    --ax-accent: #ff9500;
    --ax-accent-2: #e08600;
    --ax-accent-soft: rgba(255, 149, 0, 0.14);
    --ax-on-accent: #1a1a1a;
    --ax-ok: #5cb85c;
    --ax-ok-soft: rgba(92, 184, 92, 0.14);
    --ax-warn: #ffc107;
    --ax-warn-soft: rgba(255, 193, 7, 0.12);
    --ax-bad: #e05252;
    --ax-bad-soft: rgba(224, 82, 82, 0.13);
    /* 结果树行头浅色三态：通过=浅绿 / 未通过=浅红 / 跳过=浅蓝（比基色调浅一档，深底可读） */
    --ax-ok-light: #8ed19a;
    --ax-bad-light: #ec8a8a;
    --ax-skip-light: #7fb0e8;
    --ax-r-s: 4px;
    --ax-r-m: 8px;
    --ax-s2: 8px;
    --ax-s3: 12px;
}

/* ===== Root layout ===== */
.axu-theme-ue5 {
    background-color: var(--ax-bg);
    flex-grow: 1;
    padding: var(--ax-s2);
}

.ax-topbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ax-s2);
    padding: var(--ax-s2);
    border-radius: var(--ax-r-m);
    background-color: var(--ax-surface);
    border-width: 1px;
    border-color: var(--ax-line);
}

.ax-main {
    flex-grow: 1;
    flex-direction: row;
}

.ax-split {
    flex-grow: 1;
}

/* 左右分栏的拖拽分隔条：默认 hairline，悬停转主题橙提示可拖拽 */
.ax-split .unity-two-pane-split-view__dragline {
    background-color: var(--ax-line-2);
}

.ax-split .unity-two-pane-split-view__dragline:hover {
    background-color: var(--ax-accent);
}

/* 两栏在 TwoPaneSplitView 内，尺寸由控件接管（固定侧内联 width / 活动侧内联 flexGrow）。
   此处绝不可写 flex-basis/flex-grow —— 样式表 flex-basis 会压过控件设的内联 width，
   导致拖拽条移动而面板不跟随。左栏固定宽（flex-shrink:0），右栏弹性填充。 */
.ax-pane {
    flex-grow: 0;
    flex-shrink: 0;
    border-radius: var(--ax-r-m);
    background-color: var(--ax-surface);
    border-width: 1px;
    border-color: var(--ax-line);
    padding: var(--ax-s2);
    margin-right: var(--ax-s2);
}

.ax-pane-last {
    flex-grow: 1;
    flex-shrink: 0;
    margin-right: 0;
    margin-left: var(--ax-s2);
}

.ax-pane-header {
    color: var(--ax-text-2);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.ax-scroll {
    flex-grow: 1;
}

.ax-statusbar {
    flex-direction: row;
    margin-top: var(--ax-s2);
    padding: 6px var(--ax-s2);
    border-radius: var(--ax-r-s);
    background-color: var(--ax-surface-2);
    border-width: 1px;
    border-color: var(--ax-line);
}

.ax-status-text {
    color: var(--ax-text-2);
    white-space: normal;
    flex-shrink: 1;
}

/* ===== Top bar controls ===== */
.ax-mode-button {
    height: 24px;
    border-radius: var(--ax-r-s);
    background-color: var(--ax-surface-2);
    color: var(--ax-text-2);
    border-width: 1px;
    border-color: var(--ax-line-2);
    margin-right: 4px;
    padding-left: 10px;
    padding-right: 10px;
}

.ax-mode-button:hover {
    background-color: var(--ax-hover);
}

.ax-mode-active {
    background-color: var(--ax-accent-soft);
    color: var(--ax-accent);
    border-color: var(--ax-accent);
    -unity-font-style: bold;
}

.ax-run-button {
    height: 24px;
    min-width: 64px;
    border-radius: var(--ax-r-s);
    background-color: var(--ax-accent);
    color: var(--ax-on-accent);
    -unity-font-style: bold;
    border-width: 0;
    margin-right: 8px;
}

.ax-run-button:hover {
    background-color: var(--ax-accent-2);
}

.ax-secondary-button {
    height: 24px;
    border-radius: var(--ax-r-s);
    background-color: var(--ax-surface-2);
    color: var(--ax-text-2);
    border-width: 1px;
    border-color: var(--ax-line-2);
    margin-right: 8px;
    padding-left: 10px;
    padding-right: 10px;
}

.ax-secondary-button:hover {
    background-color: var(--ax-hover);
}

.ax-filter-field {
    flex-grow: 1;
    height: 24px;
    margin-right: 8px;
}

.ax-filter-field > #unity-text-input {
    height: 24px;
    border-radius: var(--ax-r-s);
    background-color: var(--ax-surface-2);
    border-width: 1px;
    border-color: var(--ax-line-2);
    color: var(--ax-text);
}

.ax-report-path {
    height: 24px;
    max-width: 220px;
    border-radius: var(--ax-r-s);
    background-color: transparent;
    color: var(--ax-text-3);
    border-width: 1px;
    border-color: var(--ax-line-2);
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.ax-report-path:hover {
    color: var(--ax-accent);
    border-color: var(--ax-accent);
}

/* ===== Left pane: suite tree ===== */
.ax-group-foldout .unity-foldout__content {
    margin-left: 8px;
}

.ax-fixture-foldout {
    margin-left: 8px;
}

/* 用例行 = 勾选框 + 名称（横向行容器）；勾选态由窗口内 HashSet 按 FullName 回填 */
.ax-test-row {
    flex-direction: row;
    align-items: center;
    padding: 1px 4px 1px 12px;
    border-radius: var(--ax-r-s);
}

.ax-test-row:hover {
    background-color: var(--ax-hover);
}

.ax-test-row-label {
    color: var(--ax-text);
    -unity-text-align: middle-left;
}

.ax-test-row:hover .ax-test-row-label {
    color: var(--ax-accent);
}

.ax-test-check {
    margin-right: 4px;
}

/* fixture/程序集头部的层级三态勾选框：推到头部行右侧；全选=打勾、部分=mixed 填充（无勾图形）、无=空。
   注意 Unity 6 的 Toggle 内部为 unity-toggle__input > unity-toggle__checkmark（勾选框视觉在 checkmark 上，
   无 unity-toggle__check 这个类），必须用后代选择器定位 checkmark（> 子选择器与旧类名实测均不命中）。 */
.ax-tree-check {
    margin-left: auto;
    margin-right: 4px;
}

.ax-tree-check .unity-toggle__checkmark {
    min-width: 14px;
    height: 14px;
}

.ax-tree-check.ax-check-mixed .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--ax-accent);
    border-radius: 2px;
}

.ax-tree-check.ax-check-mixed:hover .unity-toggle__checkmark {
    background-color: var(--ax-accent-2);
}

.ax-footnote {
    color: var(--ax-text-3);
    font-size: 10px;
    white-space: normal;
    margin-top: var(--ax-s2);
}

.ax-empty-note {
    color: var(--ax-text-3);
    padding: var(--ax-s2);
    white-space: normal;
}

/* ===== Right pane: result tree ===== */
.ax-summary {
    color: var(--ax-text);
    font-size: 12px;
    -unity-font-style: bold;
    padding: 4px 0;
    white-space: normal;
}

.ax-result-row {
    margin-left: 8px;
}

/* 行头文本允许换行（长全名/耗时后缀）。
   行头着色的目标层（Unity 6 实测结构，三层都要考虑）：
   ① Foldout 头部是 Toggle（unity-foldout__toggle），着色它只影响箭头附近、文本不受影响；
   ② 文本由内层 Label 渲染，类链 unity-text-element.unity-label.unity-toggle__text.unity-foldout__text，
      主题规则 .axu-theme-ue5 .unity-label (0,2,0) 直接命中它、显式规则压过继承——
      故行色必须落在 .unity-foldout__text 上且带 .axu-theme-ue5 前缀（0,3,0）才能生效。 */
.ax-result-row .unity-toggle__text {
    white-space: normal;
    flex-shrink: 1;
}

.axu-theme-ue5 .ax-row-pass .unity-foldout__text {
    color: var(--ax-ok-light);
}

.axu-theme-ue5 .ax-row-skip .unity-foldout__text {
    color: var(--ax-skip-light);
}

.axu-theme-ue5 .ax-row-fail .unity-foldout__text {
    color: var(--ax-bad-light);
    -unity-font-style: bold;
}

.ax-result-detail {
    color: var(--ax-text-2);
    font-size: 11px;
    white-space: normal;
    padding: 2px 4px 6px 16px;
}

/* ===== Foldout arrows / headers tinting (editor theme alignment) ===== */
.axu-theme-ue5 .unity-foldout__toggle {
    color: var(--ax-text);
    -unity-font-style: bold;
}

.axu-theme-ue5 .unity-foldout__toggle:hover {
    color: var(--ax-accent);
}

.axu-theme-ue5 .unity-label {
    color: var(--ax-text);
}
