/* ==================================================================
   AxuFrameKit Common Window Styles — Component Layer (AxuKit Design System)
   ------------------------------------------------------------------
   只引用 var(--kb-*) token（定义见 Editor/Common/UI/AxuKitTokens.uss）。
   加载本样式表的窗口须同时加载 AxuKitTokens.uss，并在根元素挂 .theme-* 类
   （见 AxuKitTheme）。保留全部既有类名。
   ================================================================== */

/* ===== Root ===== */
.ue5-root {
    background-color: var(--kb-bg);
    color: var(--kb-text);
    font-size: var(--kb-f-body);
    -unity-font-style: normal;
    padding: var(--kb-s1);
}

/* ===== Window Title (in-page big title; 独立窗口如已无标题栏重复可不用) ===== */
.window-title {
    font-size: var(--kb-f-head);
    -unity-font-style: bold;
    color: var(--kb-text);
    margin-bottom: var(--kb-s2);
    padding-left: var(--kb-s1);
}

/* ===== Header Label ===== */
.header-label {
    height: 28px;
    min-height: 28px;
    background-color: var(--kb-surface);
    color: var(--kb-text-2);
    font-size: var(--kb-f-caption);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    padding-top: 1px;
    -unity-text-align: middle-left;
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
    border-top-left-radius: var(--kb-r-m);
    border-top-right-radius: var(--kb-r-m);
}

/* ===== Panels (card) ===== */
.rounded-panel,
.toolbar-panel,
.group-container {
    background-color: var(--kb-surface);
    border-radius: var(--kb-r-l);
    border-width: 1px;
    border-color: var(--kb-line);
}

.toolbar-panel {
    padding: var(--kb-s2) var(--kb-s3);
    margin-bottom: var(--kb-s2);
    flex-direction: row;
    align-items: center;
}

.content-scroll {
    flex-grow: 1;
    background-color: transparent;
}

/* ===== Group ===== */
.group-container {
    margin-bottom: 10px;
    overflow: hidden;
}

.group-header {
    flex-direction: row;
    align-items: center;
    background-color: var(--kb-surface-2);
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
}

.group-title {
    flex-grow: 1;
    font-size: var(--kb-f-body);
    -unity-font-style: bold;
    color: var(--kb-text);
}

.group-content {
    padding: 6px;
}

/* ===== Item Row ===== */
.item-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--kb-surface-2);
    border-radius: var(--kb-r-m);
    padding: 4px 6px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: transparent;
    transition-duration: 0.1s;
}

.item-row:hover {
    background-color: var(--kb-hover);
    border-color: transparent;
}

.item-row-current {
    background-color: var(--kb-ok-soft);
    border-color: transparent;
}

.item-icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-name {
    flex-grow: 1;
    font-size: var(--kb-f-caption);
    color: var(--kb-text);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.item-name-starred {
    color: var(--kb-warn);
}

/* ===== Star / Remove / Delete Buttons ===== */
.star-btn {
    width: 28px;
    height: 24px;
    min-width: 28px;
    font-size: 14px;
    background-color: transparent;
    border-width: 0;
    border-radius: var(--kb-r-s);
    color: var(--kb-text-3);
    margin-right: 4px;
    padding: 0;
}

.star-btn:hover {
    background-color: var(--kb-hover);
}

.star-btn-active {
    color: var(--kb-warn);
    background-color: var(--kb-warn-soft);
}

.remove-btn {
    width: 28px;
    height: 24px;
    min-width: 28px;
    font-size: 12px;
    background-color: transparent;
    border-width: 0;
    border-radius: var(--kb-r-s);
    color: var(--kb-bad);
    margin-right: 4px;
    padding: 0;
}

.remove-btn:hover {
    background-color: var(--kb-bad-soft);
}

.delete-group-btn {
    width: 22px;
    height: 22px;
    min-width: 22px;
    font-size: 12px;
    background-color: transparent;
    border-width: 0;
    color: var(--kb-text-3);
    padding: 0;
    border-radius: var(--kb-r-s);
}

.delete-group-btn:hover {
    color: var(--kb-bad);
    background-color: var(--kb-bad-soft);
}

/* ===== Buttons ===== */
.action-btn {
    height: 24px;
    min-height: 24px;
    min-width: 28px;
    font-size: var(--kb-f-caption);
    background-color: var(--kb-surface-2);
    border-width: 0;
    border-radius: var(--kb-r-s);
    color: var(--kb-text);
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 2px;
    transition-duration: 0.1s;
}

.action-btn:hover {
    background-color: var(--kb-hover);
}

.action-btn:active {
    background-color: var(--kb-active);
}

.primary-btn {
    height: 28px;
    min-height: 28px;
    font-size: var(--kb-f-caption);
    -unity-font-style: bold;
    background-color: var(--kb-accent);
    color: var(--kb-on-accent);
    border-radius: var(--kb-r-m);
    border-width: 0;
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    transition-duration: 0.1s;
}

.primary-btn:hover {
    background-color: var(--kb-accent-2);
}

.primary-btn:active {
    background-color: var(--kb-accent-2);
}

.danger-btn {
    height: 26px;
    min-height: 26px;
    font-size: var(--kb-f-caption);
    background-color: var(--kb-bad-soft);
    border-width: 0;
    border-radius: var(--kb-r-m);
    color: var(--kb-bad);
    padding-left: var(--kb-s2);
    padding-right: var(--kb-s2);
    transition-duration: 0.1s;
}

.danger-btn:hover {
    background-color: var(--kb-bad-soft);
    color: var(--kb-bad);
}

/* 无边框纯文本按钮（图标/文字按钮通用），替代 C# 内联的
   backgroundColor=Color.clear + 4x border=0 样板 */
.bare-btn {
    background-color: transparent;
    border-width: 0;
    border-radius: var(--kb-r-s);
    padding: 0;
}

.bare-btn:hover {
    background-color: var(--kb-hover);
}

/* ===== Text Field ===== */
.ue5-text-field {
    flex-grow: 1;
    margin-right: var(--kb-s2);
}

.ue5-text-field > .unity-text-field__input {
    background-color: var(--kb-surface-2);
    border-width: 1px;
    border-color: var(--kb-line);
    border-radius: var(--kb-r-s);
    color: var(--kb-text);
    padding: 4px var(--kb-s2);
    font-size: var(--kb-f-caption);
    min-height: 24px;
}

.ue5-text-field > .unity-text-field__input:hover {
    border-color: var(--kb-line-2);
}

.ue5-text-field > .unity-text-field__input:focus {
    border-color: var(--kb-accent);
    background-color: var(--kb-bg);
}

/* ===== Toolbar Label ===== */
.toolbar-label {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
    margin-right: var(--kb-s2);
    -unity-font-style: bold;
}

/* ===== Help Box ===== */
.help-box {
    background-color: var(--kb-accent-soft);
    border-radius: var(--kb-r-m);
    border-width: 0;
    padding: 10px var(--kb-s3);
    margin: var(--kb-s2) 0;
}

.help-box-text {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ===== Empty State ===== */
.empty-state {
    padding: var(--kb-s3);
    -unity-text-align: middle-center;
}

.empty-state-text {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-3);
    -unity-font-style: italic;
}

/* ===== Badge ===== */
.badge {
    background-color: var(--kb-accent);
    color: var(--kb-on-accent);
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 8px;
    margin-left: 6px;
}

.badge-build {
    background-color: var(--kb-ok);
    color: var(--kb-on-accent);
}

.badge-current {
    background-color: var(--kb-ok-soft);
    color: var(--kb-ok);
}

/* ===== Column Toggle Button (pill multi-select) ===== */
.column-toggle-btn {
    margin-right: 6px;
    margin-bottom: 6px;
    height: 26px;
    border-radius: 13px;
    background-color: var(--kb-surface-2);
    border-width: 0;
    color: var(--kb-text-2);
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    transition-duration: 0.1s;
}

.column-toggle-btn:hover {
    background-color: var(--kb-hover);
    color: var(--kb-text);
}

.column-toggle-btn.active {
    background-color: var(--kb-accent);
    color: var(--kb-on-accent);
    -unity-font-style: bold;
}

.column-toggle-btn.active:hover {
    background-color: var(--kb-accent-2);
    color: var(--kb-on-accent);
}

/* ===== Helper Button Row ===== */
.helper-btn-row {
    flex-direction: row;
    margin-top: var(--kb-s2);
    border-top-width: 1px;
    border-top-color: var(--kb-line);
    padding-top: var(--kb-s2);
}

.helper-text-btn {
    background-color: transparent;
    border-width: 0;
    color: var(--kb-accent);
    margin-right: 10px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: var(--kb-r-s);
}

.helper-text-btn:hover {
    color: var(--kb-accent);
    background-color: var(--kb-hover);
}

/* ===== Drag & Drop Hint Overlay ===== */
.drag-hint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--kb-accent-soft);
    border-width: 2px;
    border-radius: var(--kb-r-l);
    border-color: var(--kb-accent);
    align-items: center;
    justify-content: center;
    display: none;
}

.drag-hint-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--kb-text);
}

/* ===== Semantic Text ===== */
.text-secondary {
    color: var(--kb-text-2);
}

.text-muted {
    color: var(--kb-text-3);
}

.text-ok {
    color: var(--kb-ok);
}

.text-warn {
    color: var(--kb-warn);
}

.text-bad {
    color: var(--kb-bad);
}

.text-accent {
    color: var(--kb-accent);
}

/* ===== Scrollbars (slim pill) ===== */
.unity-scroller {
    background-color: transparent;
}

.unity-scroller--vertical {
    width: 8px;
}

.unity-base-slider__dragger {
    background-color: var(--kb-dragger);
    border-radius: 4px;
    border-width: 0;
    margin: 2px;
}

.unity-base-slider__dragger:hover {
    background-color: var(--kb-dragger-hover);
}

.unity-base-slider__dragger:active {
    background-color: var(--kb-accent);
}
