/* ==================================================================
   Hierarchy Icon Window - UE5 Style Theme
   Based on LiveStream User Config Window & Colorizer Window
   ================================================================== */

/* ===== CSS Variables (UE5 Color Palette) ===== */
:root {
    /* Primary Background Colors */
    --ue5-bg-darkest: #1a1a1a;
    --ue5-bg-dark: #1e1e1e;
    --ue5-bg-panel: #242424;
    --ue5-bg-element: #2a2a2a;
    --ue5-bg-hover: #333333;
    --ue5-bg-active: #3a3a3a;
    
    /* Accent Colors (UE5 Orange) */
    --ue5-accent-primary: #ff9500;
    --ue5-accent-secondary: #e68a00;
    --ue5-accent-border: rgba(255, 149, 0, 0.4);
    
    /* Border Colors */
    --ue5-border-dark: #0d0d0d;
    --ue5-border-subtle: #383838;
    --ue5-border-light: #454545;
    
    /* Text Colors */
    --ue5-text-primary: #e8e8e8;
    --ue5-text-secondary: #a0a0a0;
    --ue5-text-disabled: #666666;
    --ue5-text-highlight: #ffffff;
    
    /* Button Colors */
    --ue5-btn-bg: #3d3d3d;
    --ue5-btn-hover: #4a4a4a;
    --ue5-btn-active: #555555;
    --ue5-btn-primary-bg: #ff9500;
    --ue5-btn-primary-hover: #ffaa33;
    --ue5-btn-primary-active: #cc7700;
}

/* ===== Root Container ===== */
.ue5-root {
    background-color: var(--ue5-bg-darkest);
    color: var(--ue5-text-primary);
    font-size: 12px;
    flex-grow: 1;
}

/* ===== Header Labels ===== */
.header-label {
    height: 28px;
    min-height: 28px;
    background-color: var(--ue5-bg-dark);
    color: var(--ue5-text-secondary);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 1px;
    -unity-text-align: middle-left;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue5-border-dark);
    border-top-width: 1px;
    border-top-color: var(--ue5-border-subtle);
}

.section-label {
    height: 24px;
    min-height: 24px;
    background-color: var(--ue5-bg-panel);
    color: var(--ue5-text-secondary);
    font-size: 10px;
    -unity-font-style: bold;
    padding-left: 8px;
    padding-top: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue5-border-dark);
    margin-top: 4px;
}


/* ===== Panel Containers ===== */
.ue5-panel {
    background-color: var(--ue5-bg-element);
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-radius: 2px;
    padding: 8px;
    margin: 4px;
}

/* ===== Built-in Component Grid ===== */
.builtin-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: 10px;
    margin-right: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
}

.builtin-item {
    width: 33.3333%;
    margin: 5px;
    flex-shrink: 0;
    min-width: 100px;
    padding: 10px;
}


/* ===== Toggle Buttons (Filter Style) ===== */
.component-toggle-btn {
    height: 24px;
    min-height: 24px;
    font-size: 11px;
    -unity-font-style: normal;
    border-radius: 10px;
    border-width: 1px;
    padding-left: 8px;
    padding-right: 8px;
    margin: 0;
    transition-duration: 0.1s;
    -unity-text-align: middle-left;
}

.component-toggle-btn .unity-label {
   flex-grow: 1;
}

.component-toggle-btn--active {
    background-color: var(--ue5-accent-primary);
    border-color: var(--ue5-accent-secondary);
    color: #1a1a1a;
    -unity-font-style: bold;
}

.component-toggle-btn--active:hover {
    background-color: var(--ue5-accent-secondary);
}

.component-toggle-btn--inactive {
    background-color: #3a3a3a;
    border-color: #505050;
    color: var(--ue5-text-primary);
}

.component-toggle-btn--inactive:hover {
    background-color: #454545;
    border-color: #606060;
}


/* ===== Buttons - UE5 Style ===== */
.ue5-button {
    height: 26px;
    min-height: 26px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    background-color: var(--ue5-btn-bg);
    color: var(--ue5-text-primary);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-bottom-color: #0a0a0a;
    border-top-color: var(--ue5-border-light);
    margin: 4px;
    padding-left: 16px;
    padding-right: 16px;
    transition-duration: 0.1s;
}

.ue5-button:hover {
    background-color: var(--ue5-btn-hover);
    border-top-color: var(--ue5-border-light);
    color: var(--ue5-text-highlight);
}

.ue5-button:active {
    background-color: var(--ue5-btn-active);
    border-top-color: var(--ue5-border-dark);
    border-bottom-color: var(--ue5-border-light);
}

.ue5-button-primary {
    background-color: var(--ue5-btn-primary-bg);
    color: #1a1a1a;
    border-color: var(--ue5-accent-secondary);
}

.ue5-button-primary:hover {
    background-color: var(--ue5-btn-primary-hover);
    color: #1a1a1a;
}

.ue5-button-primary:active {
    background-color: var(--ue5-btn-primary-active);
}

/* ===== Text Fields ===== */
.unity-text-field {
    background-color: transparent;
    border-width: 0;
    margin: 2px;
}

.unity-text-field > .unity-text-field__input {
    background-color: var(--ue5-bg-darkest);
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-radius: 2px;
    color: var(--ue5-text-primary);
    padding: 4px 8px;
}

.unity-text-field > .unity-text-field__input:hover {
    border-color: var(--ue5-border-light);
}

.unity-text-field > .unity-text-field__input:focus {
    border-color: var(--ue5-accent-primary);
}

/* ===== Float Fields ===== */
.unity-float-field {
    margin: 2px;
}

.unity-float-field > .unity-float-field__input {
    background-color: var(--ue5-bg-darkest);
    border-width: 1px;
    border-color: var(--ue5-border-dark);
    border-radius: 2px;
    color: var(--ue5-text-primary);
    padding: 2px 6px;
}
.unity-float-field > .unity-float-field__input:focus {
    border-color: var(--ue5-accent-primary);
}


/* ===== Rule Item Styling ===== */
.rule-item {
    flex-direction: column;
    background-color: var(--ue5-bg-element);
    border-width: 1px;
    border-color: var(--ue5-accent-border);
    border-radius: 6px;
    padding: 8px;
    margin-bottom: 8px;
    margin-left: 6px;
    margin-right: 6px;
}

.rule-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.rule-title {
    -unity-font-style: bold;
    color: var(--ue5-text-primary);
    flex-grow: 1;
    margin-left: 4px;
}

.rule-remove-btn {
    width: 20px;
    height: 20px;
    background-color: transparent;
    border-width: 0;
    color: var(--ue5-text-secondary);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.rule-remove-btn:hover {
    color: #ff4444;
}

.rule-content {
    padding-left: 20px;
}

.rule-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.rule-label {
    width: 100px;
    color: var(--ue5-text-secondary);
    font-size: 11px;
}

.rule-control {
    flex-grow: 1;
}

/* ScrollView */
.rules-scroll-view {
    flex-grow: 1;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Footer */
.window-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding: 8px;
    background-color: var(--ue5-bg-dark);
    border-top-width: 1px;
    border-top-color: var(--ue5-border-dark);
}

.add-rule-btn-container {
    padding: 8px;
    align-items: center;
}
