/* ==================================================================
   CsvContainerCreatorWindow — Component Layer (AxuKit Design System)
   ------------------------------------------------------------------
   只引用 var(--kb-*) token（定义见 Editor/Common/UI/AxuKitTokens.uss）。
   加载本样式表的窗口须同时加载 AxuKitTokens.uss，并在根元素挂 .theme-* 类。
   保留全部既有类名。
   ================================================================== */

/* ===== Shared component styles (window loads tokens + this file only) ===== */
.ue5-root {
    background-color: var(--kb-bg);
    color: var(--kb-text);
    font-size: var(--kb-f-body);
    -unity-font-style: normal;
    padding: var(--kb-s1);
}

.window-title {
    font-size: var(--kb-f-head);
    -unity-font-style: bold;
    color: var(--kb-text);
    margin-bottom: var(--kb-s2);
    padding-left: var(--kb-s1);
}

.toolbar-panel {
    background-color: var(--kb-surface);
    border-radius: var(--kb-r-l);
    border-width: 1px;
    border-color: var(--kb-line);
    padding: var(--kb-s2) var(--kb-s3);
    margin-bottom: var(--kb-s2);
    flex-direction: row;
    align-items: center;
}

.toolbar-label {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
    margin-right: var(--kb-s2);
    -unity-font-style: bold;
}

.content-scroll {
    flex-grow: 1;
    background-color: transparent;
}

.group-container {
    background-color: var(--kb-surface);
    border-radius: var(--kb-r-l);
    border-width: 1px;
    border-color: var(--kb-line);
    margin-bottom: 10px;
    overflow: hidden;
}

.group-header {
    flex-direction: row;
    align-items: center;
    background-color: var(--kb-surface-2);
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
}

.group-title {
    flex-grow: 1;
    font-size: var(--kb-f-body);
    -unity-font-style: bold;
    color: var(--kb-text);
}

.group-content {
    padding: 6px;
}

.item-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--kb-surface-2);
    border-radius: var(--kb-r-m);
    padding: 4px 6px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: transparent;
    transition-duration: 0.1s;
}

.item-row:hover {
    background-color: var(--kb-hover);
    border-color: transparent;
}

.item-icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-name {
    flex-grow: 1;
    font-size: var(--kb-f-caption);
    color: var(--kb-text);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.action-btn {
    height: 24px;
    min-height: 24px;
    min-width: 28px;
    font-size: var(--kb-f-caption);
    background-color: var(--kb-surface-2);
    border-width: 0;
    border-radius: var(--kb-r-s);
    color: var(--kb-text);
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 2px;
    flex-shrink: 0;
    transition-duration: 0.1s;
}

.action-btn:hover {
    background-color: var(--kb-hover);
}

.action-btn:active {
    background-color: var(--kb-active);
}

.primary-btn {
    height: 28px;
    min-height: 28px;
    font-size: var(--kb-f-caption);
    -unity-font-style: bold;
    background-color: var(--kb-accent);
    color: var(--kb-on-accent);
    border-radius: var(--kb-r-m);
    border-width: 0;
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    transition-duration: 0.1s;
}

.primary-btn:hover {
    background-color: var(--kb-accent-2);
}

.primary-btn:active {
    background-color: var(--kb-accent-2);
}

.ue5-text-field {
    flex-grow: 1;
    margin-right: var(--kb-s2);
}

.ue5-text-field > .unity-text-field__input {
    background-color: var(--kb-surface-2);
    border-width: 1px;
    border-color: var(--kb-line);
    border-radius: var(--kb-r-s);
    color: var(--kb-text);
    padding: 4px var(--kb-s2);
    font-size: var(--kb-f-caption);
    min-height: 24px;
}

.ue5-text-field > .unity-text-field__input:hover {
    border-color: var(--kb-line-2);
}

.ue5-text-field > .unity-text-field__input:focus {
    border-color: var(--kb-accent);
    background-color: var(--kb-bg);
}

.help-box {
    background-color: var(--kb-accent-soft);
    border-radius: var(--kb-r-m);
    border-width: 0;
    padding: 10px var(--kb-s3);
    margin: var(--kb-s2) 0;
}

.help-box-text {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
    -unity-text-align: middle-center;
    white-space: normal;
}

.empty-state {
    padding: var(--kb-s3);
    -unity-text-align: middle-center;
}

.empty-state-text {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-3);
    -unity-font-style: italic;
}

.badge {
    background-color: var(--kb-accent);
    color: var(--kb-on-accent);
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 8px;
    margin-left: 6px;
}

.badge-build {
    background-color: var(--kb-ok);
    color: var(--kb-on-accent);
}

.bare-btn {
    background-color: transparent;
    border-width: 0;
    border-radius: var(--kb-r-s);
    padding: 0;
}

.bare-btn:hover {
    background-color: var(--kb-hover);
}

.text-accent {
    color: var(--kb-accent);
}

.unity-scroller {
    background-color: transparent;
}

.unity-scroller--vertical {
    width: 8px;
}

.unity-base-slider__dragger {
    background-color: var(--kb-dragger);
    border-radius: 4px;
    border-width: 0;
    margin: 2px;
}

.unity-base-slider__dragger:hover {
    background-color: var(--kb-dragger-hover);
}

.unity-base-slider__dragger:active {
    background-color: var(--kb-accent);
}

/* ==================================================================
   Window Specific Styles
   ================================================================== */

/* ===== Main Split Layout ===== */
.csv-main-container {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* ===== Left Panel (type list) ===== */
.csv-left-panel {
    width: 320px;
    min-width: 280px;
    max-width: 450px;
    display: flex;
    flex-direction: column;
    margin-right: 6px;
}

/* ===== Right Panel (detail) ===== */
.csv-right-panel {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

/* ===== Selected Item Highlight ===== */
.csv-item-selected {
    background-color: var(--kb-accent-soft);
    border-color: var(--kb-accent-line);
}

.csv-item-selected:hover {
    background-color: var(--kb-accent-soft);
}

/* ===== Namespace Badge (small pill) ===== */
.csv-ns-badge {
    font-size: 9px;
    color: var(--kb-text-3);
    background-color: var(--kb-surface-2);
    border-width: 0;
    border-radius: 6px;
    padding-left: 5px;
    padding-right: 5px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ===== Detail Info Row ===== */
.csv-info-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
    padding: 6px 8px;
    background-color: var(--kb-surface-2);
    border-radius: var(--kb-r-s);
    border-width: 0;
}

.csv-info-label {
    width: 90px;
    min-width: 90px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--kb-text-3);
    -unity-text-align: middle-left;
}

.csv-info-value {
    flex-grow: 1;
    font-size: var(--kb-f-caption);
    color: var(--kb-text);
    white-space: normal;
    overflow: hidden;
}

/* ===== Separator ===== */
.csv-separator {
    height: 1px;
    background-color: var(--kb-line);
    margin-top: var(--kb-s2);
    margin-bottom: var(--kb-s3);
}

/* ===== Create Asset Button (full-width override) ===== */
.csv-create-btn {
    align-self: stretch;
    height: 36px;
    font-size: 13px;
    margin-top: 0;
}

/* ===== Asset path label in Existing Assets rows ===== */
.csv-asset-path {
    font-size: 10px;
    color: var(--kb-text-3);
    -unity-text-align: middle-right;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
    margin-right: 4px;
}

/* ===== Fields Section Title ===== */
.csv-fields-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--kb-text-3);
    letter-spacing: 1px;
    margin-top: 10px;
    margin-bottom: 4px;
    padding-left: 2px;
}

/* ===== Field Row ===== */
.csv-field-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--kb-surface-2);
    border-radius: var(--kb-r-s);
    border-width: 0;
    padding: 4px 8px;
    margin-bottom: 3px;
}

.csv-field-row:hover {
    background-color: var(--kb-hover);
}

/* Type keyword (int, string, …) */
.csv-field-type {
    font-size: var(--kb-f-caption);
    color: var(--kb-accent);
    -unity-font-style: bold;
    margin-right: 6px;
    min-width: 48px;
}

/* Member name */
.csv-field-name {
    font-size: var(--kb-f-caption);
    color: var(--kb-text);
    flex-grow: 1;
}

/* Arrow between member name and column name */
.csv-field-arrow {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-3);
    margin-left: 4px;
    margin-right: 4px;
}

/* CSV column name string */
.csv-field-colname {
    font-size: var(--kb-f-caption);
    color: var(--kb-ok);
    margin-right: 4px;
}

/* ===== Field Badges ===== */
.csv-field-badge {
    font-size: 9px;
    border-radius: 6px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-left: 3px;
    -unity-text-align: middle-center;
}

/* optional badge */
.csv-field-badge--optional {
    background-color: var(--kb-warn-soft);
    border-width: 0;
    color: var(--kb-warn);
}

/* no-column badge — dim */
.csv-field-badge--none {
    background-color: var(--kb-surface-2);
    border-width: 0;
    color: var(--kb-text-3);
}

/* FinalParse badge */
.csv-field-badge--final {
    background-color: var(--kb-accent-soft);
    border-width: 0;
    color: var(--kb-accent);
}

/* ===== Inspector Meta Block (InspectorTitle + InspectorIntro) ===== */
.csv-meta-block {
    margin-bottom: 10px;
    padding: 8px 4px 4px 4px;
}

/* Large centered title (mirrors InspectorTitleAttribute) */
.csv-meta-title {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--kb-text);
    /* font-size is set inline from titleAttr.FontSize / 2 */
    margin-bottom: 6px;
}

/* Intro / description text (mirrors InspectorIntroAttribute) */
.csv-meta-intro {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
    white-space: normal;
    padding: 4px 2px;
    margin-bottom: 6px;
}

/* Divider after title */
.csv-meta-divider {
    height: 1px;
    background-color: var(--kb-line-2);
    margin-bottom: var(--kb-s2);
}

/* Divider after intro — lighter */
.csv-meta-divider--light {
    background-color: var(--kb-line);
}
