/* ========================================
   Unreal Engine 5 Theme for KitBoxRevV2
   ======================================== */

:root {
    /* UE5 Color Palette */
    --ue-dark-bg: #1a1a1a;
    --ue-darker-bg: #0d0d0d;
    --ue-panel-bg: #212121;
    --ue-header-bg: #2a2a2a;
    --ue-accent-blue: #0e7afe;
    --ue-accent-blue-hover: #1e8aff;
    --ue-accent-orange: #ff9800;
    --ue-success-green: #4caf50;
    --ue-danger-red: #f44336;
    --ue-text-primary: #e0e0e0;
    --ue-text-secondary: #9e9e9e;
    --ue-text-muted: #616161;
    --ue-border-color: #333333;
    --ue-border-highlight: #444444;
    
    /* Spacing */
    --sidebar-width: 240px;
    --header-height: 48px;
}

/* ========================================
   Main Layout
   ======================================== */

#root-container {
    flex-direction: row;
    height: 100%;
    background-color: var(--ue-darker-bg);
    color: var(--ue-text-primary);
    font-size: 13px;
}

/* ========================================
   Sidebar - UE5 Style
   ======================================== */

#sidebar {
    width: var(--sidebar-width);
    background-color: var(--ue-dark-bg);
    border-right-width: 1px;
    border-right-color: var(--ue-border-color);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

#sidebar-header {
    height: var(--header-height);
    background-color: var(--ue-darker-bg);
    justify-content: center;
    padding-left: 20px;
    border-bottom-width: 2px;
    border-bottom-color: var(--ue-accent-blue);
}

#sidebar-header-label {
    -unity-font-style: bold;
    color: var(--ue-accent-blue);
    font-size: 15px;
    letter-spacing: 1.5px;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(14, 122, 254, 0.3);
}

#nav-scroll-view {
    flex-grow: 1;
    background-color: var(--ue-dark-bg);
}

#nav-container {
    padding: 12px 8px;
}

#sidebar-footer {
    padding: 16px;
    background-color: var(--ue-darker-bg);
    border-top-width: 1px;
    border-top-color: var(--ue-border-color);
}

#refresh-button {
    height: 36px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: var(--ue-accent-blue);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: white;
    -unity-font-style: bold;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#refresh-button:hover {
    background-color: var(--ue-accent-blue-hover);
    scale: 1.02;
}

#refresh-button:active {
    background-color: #0d6edf;
    scale: 0.98;
}

/* ========================================
   Main Content Area
   ======================================== */

#main-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--ue-darker-bg);
}

#content-header {
    height: var(--header-height);
    background-color: var(--ue-panel-bg);
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    padding: 0 24px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue-border-color);
}

#content-title {
    -unity-font-style: bold;
    font-size: 18px;
    color: var(--ue-text-primary);
    letter-spacing: 0.5px;
}

#content-body {
    flex-grow: 1;
    padding: 0;
    background-color: var(--ue-darker-bg);
}

#content-scroll-view {
    flex-grow: 1;
}

#content-container {
    padding: 0;
}

/* ========================================
   Navigation Items - UE5 Style
   ======================================== */

.group-foldout {
    margin: 6px 0;
    color: var(--ue-text-primary);
}

.group-foldout > .unity-foldout__toggle {
    margin-left: 0;
    padding: 8px 12px;
    background-color: transparent;
    border-left-width: 3px;
    border-left-color: transparent;
    transition-property: background-color, border-left-color;
    transition-duration: 0.2s;
}

.group-foldout > .unity-foldout__toggle:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-left-color: var(--ue-accent-blue);
}

.group-foldout > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--ue-text-secondary);
    letter-spacing: 0.8px;
}

.nav-item {
    margin: 3px 8px 3px 24px;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    -unity-text-align: middle-left;
    color: var(--ue-text-secondary);
    transition-property: background-color, color, translate, border-left-width;
    transition-duration: 0.2s;
}

.nav-item:hover {
    background-color: rgba(14, 122, 254, 0.15);
    color: var(--ue-accent-blue);
    translate: 4px 0;
}

.nav-item--selected {
    background-color: var(--ue-accent-blue);
    color: white;
    -unity-font-style: bold;
    border-left-width: 3px;
    border-left-color: var(--ue-accent-orange);
}

.nav-item--selected:hover {
    background-color: var(--ue-accent-blue-hover);
}

/* ========================================
   Page Styles - UE5 Theme
   ======================================== */

.page-container {
    padding: 24px;
    flex-grow: 1;
    background-color: var(--ue-darker-bg);
}

.page-header {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    color: var(--ue-text-primary);
    letter-spacing: 0.5px;
    border-left-width: 4px;
    border-left-color: var(--ue-accent-blue);
    padding-left: 12px;
}

.page-subheader {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: var(--ue-text-secondary);
}

.page-hint {
    color: var(--ue-text-muted);
    margin-bottom: 20px;
    white-space: normal;
    font-size: 13px;
    -unity-font-style: italic;
}

.section-header {
    margin-top: 32px;
    margin-bottom: 8px;
    -unity-font-style: bold;
    font-size: 14px;
    color: var(--ue-text-secondary);
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue-border-color);
    padding-bottom: 4px;
}

/* ========================================
   Buttons - UE5 Style
   ======================================== */

.btn-primary {
    height: 48px;
    font-size: 15px;
    -unity-font-style: bold;
    background-color: var(--ue-accent-blue);
    color: white;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.btn-primary:hover {
    background-color: var(--ue-accent-blue-hover);
    scale: 1.02;
}

.btn-primary:active {
    scale: 0.98;
}

.btn-primary:disabled {
    background-color: #424242;
    color: #757575;
}

.btn-success {
    height: 42px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: var(--ue-success-green);
    color: white;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.btn-success:hover {
    background-color: #66bb6a;
    scale: 1.02;
}

.btn-danger {
    height: 42px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: var(--ue-danger-red);
    color: white;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.btn-danger:hover {
    background-color: #e53935;
    scale: 1.02;
}

.btn-secondary {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--ue-text-secondary);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ue-border-color);
    border-right-color: var(--ue-border-color);
    border-top-color: var(--ue-border-color);
    border-bottom-color: var(--ue-border-color);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-left-color: var(--ue-accent-blue);
    border-right-color: var(--ue-accent-blue);
    border-top-color: var(--ue-accent-blue);
    border-bottom-color: var(--ue-accent-blue);
}

.btn-small {
    width: 28px;
    height: 28px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* ========================================
   Containers - UE5 Style
   ======================================== */

.config-box {
    background-color: var(--ue-panel-bg);
    padding: 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    margin-bottom: 24px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ue-border-color);
    border-right-color: var(--ue-border-color);
    border-top-color: var(--ue-border-color);
    border-bottom-color: var(--ue-border-color);
}

.card {
    background-color: var(--ue-panel-bg);
    padding: 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ue-border-color);
    border-right-color: var(--ue-border-color);
    border-top-color: var(--ue-border-color);
    border-bottom-color: var(--ue-border-color);
}

.slot-container {
    width: 44%;
    background-color: var(--ue-panel-bg);
    padding: 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ue-border-highlight);
    border-right-color: var(--ue-border-highlight);
    border-top-color: var(--ue-border-highlight);
    border-bottom-color: var(--ue-border-highlight);
}

.slot-title {
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: var(--ue-accent-blue);
    font-size: 13px;
}

/* ========================================
   Toolbars - UE5 Style
   ======================================== */

.toolbar {
    flex-direction: row;
    padding: 10px 16px;
    background-color: var(--ue-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--ue-border-color);
    align-items: center;
}

.toolbar-spacer {
    flex-grow: 1;
}

/* ========================================
   Lists & Views - UE5 Style
   ======================================== */

.log-view {
    flex-grow: 1;
    min-height: 160px;
    background-color: var(--ue-darker-bg);
    padding: 12px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ue-border-color);
    border-right-color: var(--ue-border-color);
    border-top-color: var(--ue-border-color);
    border-bottom-color: var(--ue-border-color);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.asset-list {
    flex-grow: 1;
    min-height: 260px;
    background-color: var(--ue-dark-bg);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ue-border-color);
    border-right-color: var(--ue-border-color);
    border-top-color: var(--ue-border-color);
    border-bottom-color: var(--ue-border-color);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.list-item-row {
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* ========================================
   Layout Helpers
   ======================================== */

.row {
    flex-direction: row;
}

.row-space-between {
    flex-direction: row;
    justify-content: space-between;
}

.row-center {
    flex-direction: row;
    align-items: center;
}

.flex-grow {
    flex-grow: 1;
}

/* ========================================
   Text Styles - UE5 Theme
   ======================================== */

.text-secondary {
    color: var(--ue-text-secondary);
}

.text-muted {
    color: var(--ue-text-muted);
    font-size: 11px;
}

.text-bold {
    -unity-font-style: bold;
}

/* ========================================
   Spacing Utilities
   ======================================== */

.mb-5 { margin-bottom: 5px; }
.mb-10 { margin-bottom: 10px; }
.mb-15 { margin-bottom: 15px; }
.mb-20 { margin-bottom: 20px; }
.mb-25 { margin-bottom: 25px; }
.mb-30 { margin-bottom: 30px; }

.mt-5 { margin-top: 5px; }
.mt-10 { margin-top: 10px; }
.mt-20 { margin-top: 20px; }
.mt-30 { margin-top: 30px; }

/* ========================================
   Welcome Page - UE5 Style
   ======================================== */

.welcome-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 48px;
    background-color: var(--ue-darker-bg);
}

.welcome-title {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--ue-accent-blue);
    margin-bottom: 12px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(14, 122, 254, 0.3);
}

.welcome-subtitle {
    font-size: 18px;
    color: var(--ue-text-secondary);
    margin-bottom: 36px;
    letter-spacing: 2px;
}

.feature-card {
    width: 260px;
    height: 110px;
    margin: 12px;
    padding: 18px;
    background-color: var(--ue-panel-bg);
    border-left-width: 4px;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--ue-border-color);
    border-right-color: var(--ue-border-color);
    border-bottom-color: var(--ue-border-color);
    transition-property: background-color, translate;
    transition-duration: 0.2s;
}

.feature-card:hover {
    background-color: var(--ue-header-bg);
    translate: 0 -4px;
}

.feature-card-title {
    -unity-font-style: bold;
    font-size: 15px;
    color: white;
    margin-bottom: 6px;
}

.feature-card-desc {
    margin-top: 6px;
    font-size: 12px;
    color: var(--ue-text-secondary);
    white-space: normal;
}

/* ========================================
   Scene Jump Specific
   ======================================== */

.scene-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ue-border-color);
}

/* ========================================
   Symbol Page - UE5 Style
   ======================================== */

.symbol-list-panel {
    width: 240px;
    border-right-width: 1px;
    border-right-color: var(--ue-border-color);
    background-color: var(--ue-dark-bg);
}

.symbol-list-header {
    padding: 12px;
    -unity-font-style: bold;
    background-color: var(--ue-header-bg);
    color: var(--ue-accent-blue);
    border-bottom-width: 1px;
    border-bottom-color: var(--ue-border-color);
}

.symbol-detail-area {
    flex-grow: 1;
    padding: 24px;
    background-color: var(--ue-darker-bg);
}

.symbol-detail-title {
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    color: var(--ue-text-primary);
    border-left-width: 4px;
    border-left-color: var(--ue-accent-blue);
    padding-left: 12px;
}

.symbol-detail-desc {
    white-space: normal;
    color: var(--ue-text-secondary);
    font-size: 14px;
    margin-bottom: 32px;
}

.symbol-status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
    padding: 12px;
    background-color: var(--ue-panel-bg);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* ========================================
   SelectionToCsv Page - UE5 Style
   ======================================== */

.asset-icon {
    width: 18px;
    height: 18px;
    margin-right: 10px;
}

.asset-type-label {
    color: var(--ue-text-muted);
    font-size: 11px;
}

.browse-button {
    width: 80px;
    background-color: var(--ue-panel-bg);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ue-border-color);
    border-right-color: var(--ue-border-color);
    border-top-color: var(--ue-border-color);
    border-bottom-color: var(--ue-border-color);
}

.browse-button:hover {
    background-color: var(--ue-header-bg);
    border-left-color: var(--ue-accent-blue);
    border-right-color: var(--ue-accent-blue);
    border-top-color: var(--ue-accent-blue);
    border-bottom-color: var(--ue-accent-blue);
}
