/* ==================================================================
   AxuKitBox V2 — Component Layer (AxuKit Design System)
   ------------------------------------------------------------------
   只引用 var(--kb-*) token（定义见 Editor/Common/UI/AxuKitTokens.uss），
   主题由根元素上的 .theme-* 类决定。本文件保留全部既有类名，
   页面 C# 无需改动即可获得新外观。
   ================================================================== */

/* ===== Root / Shell ===== */
#root-container {
    flex-direction: row;
    height: 100%;
    background-color: var(--kb-bg);
    color: var(--kb-text);
    font-size: var(--kb-f-body);
}

#sidebar {
    width: var(--kb-sidebar-w);
    background-color: var(--kb-bg-side);
    border-right-width: 1px;
    border-right-color: var(--kb-line);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

#sidebar-header {
    height: var(--kb-header-h);
    justify-content: center;
    align-items: flex-start;
    padding-left: var(--kb-s4);
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
}

#sidebar-header-label {
    -unity-font-style: bold;
    color: var(--kb-text);
    font-size: 13px;
    letter-spacing: 0.4px;
}

#nav-scroll-view {
    flex-grow: 1;
}

#nav-container {
    padding-left: var(--kb-s1);
    padding-right: var(--kb-s1);
    padding-top: var(--kb-s2);
    padding-bottom: var(--kb-s2);
}

#sidebar-footer {
    padding: var(--kb-s3);
    border-top-width: 1px;
    border-top-color: var(--kb-line);
}

#refresh-button {
    height: 30px;
    border-radius: var(--kb-r-m);
    background-color: var(--kb-surface-2);
    border-width: 0;
    color: var(--kb-text);
    transition-duration: 0.12s;
}

#refresh-button:hover {
    background-color: var(--kb-hover);
    color: var(--kb-text);
}

#refresh-button:active {
    background-color: var(--kb-active);
}

/* ===== Main Content ===== */
#main-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--kb-bg);
}

#content-header {
    height: var(--kb-header-h);
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    padding-left: var(--kb-s4);
    padding-right: var(--kb-s4);
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
}

#content-title {
    -unity-font-style: bold;
    font-size: var(--kb-f-head);
    color: var(--kb-text);
}

#content-body {
    flex-grow: 1;
    padding: 0;
}

#content-scroll-view {
    flex-grow: 1;
}

#content-container {
    padding: 0;
}

/* ===== Theme Dropdown ===== */
/* 字段外宽固定，内容自适应收缩：
   编辑器默认主题给 .unity-base-field__label 预留 min-width:120px，
   会把固定宽字段盒的剩余空间挤到小于 input 最小内容宽，
   导致 input 右向溢出字段盒、顶出窗口右缘（标签列实测恰为 120px）。 */
#theme-dropdown {
    width: 168px;
    min-width: 0;
    flex-shrink: 1; /* 窗口变窄时字段收缩，而不是把头部行顶出边界 */
}

#theme-dropdown > .unity-base-field__label {
    min-width: 0;
    width: auto;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: var(--kb-s2);
}

#theme-dropdown > .unity-base-popup-field__input {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden; /* 字段收缩时文本截断，不外溢 */
    background-color: var(--kb-surface-2);
    border-width: 1px;
    border-color: var(--kb-line);
    border-radius: var(--kb-r-m);
    color: var(--kb-text);
    font-size: var(--kb-f-caption);
}

/* ===== Sidebar Navigation ===== */
.group-foldout {
    margin: var(--kb-s1) 0;
    color: var(--kb-text-2);
}

.group-foldout > .unity-foldout__toggle {
    margin-left: 0;
    padding-left: var(--kb-s2);
    padding-right: var(--kb-s2);
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: transparent;
    border-radius: var(--kb-r-s);
}

.group-foldout > .unity-foldout__toggle:hover {
    background-color: var(--kb-hover);
}

.group-foldout > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
    font-size: var(--kb-f-caption);
    color: var(--kb-text-3);
}

.nav-item {
    margin: 1px var(--kb-s1) 1px var(--kb-s2);
    padding-left: var(--kb-s2);
    padding-right: var(--kb-s2);
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: var(--kb-r-m);
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-left;
    color: var(--kb-text-2);
    font-size: var(--kb-f-body);
    transition-duration: 0.1s;
}

.nav-item:hover {
    background-color: var(--kb-hover);
    color: var(--kb-text);
}

.nav-item--selected {
    background-color: var(--kb-accent-soft);
    color: var(--kb-accent);
    -unity-font-style: bold;
    border-left-width: 0;
}

.nav-item--selected:hover {
    background-color: var(--kb-accent-soft);
    color: var(--kb-accent);
}

/* ===== Scrollbars (slim pill) ===== */
.unity-scroller {
    background-color: transparent;
}

.unity-scroller--vertical {
    width: 8px;
}

.unity-scroller--horizontal {
    height: 8px;
}

.unity-scroller__slider {
    background-color: transparent;
    border-radius: 0;
    margin: 0;
}

.unity-base-slider__dragger {
    background-color: var(--kb-dragger);
    border-radius: 4px;
    border-width: 0;
    margin: 2px;
}

.unity-base-slider__dragger:hover {
    background-color: var(--kb-dragger-hover);
}

.unity-base-slider__dragger:active {
    background-color: var(--kb-accent);
}

/* ===== Common Page Styles ===== */
.page-container {
    padding: var(--kb-s4);
    flex-grow: 1;
}

.page-header {
    font-size: var(--kb-f-head);
    -unity-font-style: bold;
    margin-bottom: var(--kb-s3);
    color: var(--kb-text);
}

.page-subheader {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: var(--kb-s2);
    color: var(--kb-text);
}

.page-hint {
    color: var(--kb-text-2);
    margin-bottom: var(--kb-s4);
    white-space: normal;
    font-size: var(--kb-f-caption);
}

/* ===== Cards & Containers ===== */
.card,
.config-box,
.section-panel,
.slot-container,
.stat-card,
.collapsible-section {
    background-color: var(--kb-surface);
    border-radius: var(--kb-r-l);
    border-width: 1px;
    border-color: var(--kb-line);
}

.config-box {
    padding: var(--kb-s3);
    margin-bottom: var(--kb-s4);
}

.card {
    padding: var(--kb-s3);
}

.slot-container {
    width: 44%;
    padding: var(--kb-s3);
}

.slot-title {
    -unity-font-style: bold;
    margin-bottom: var(--kb-s2);
    color: var(--kb-text);
}

/* ===== Section Panel ===== */
.section-panel {
    margin-bottom: var(--kb-s4);
    overflow: hidden;
}

.section-panel--subtle {
    border-color: var(--kb-line);
}

.section-panel--no-border {
    border-width: 0;
}

.section-header {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
    border-left-width: 0;
}

.section-title {
    font-size: var(--kb-f-body);
    -unity-font-style: bold;
    color: var(--kb-text);
    flex-grow: 1;
}

.section-header-icon {
    font-size: 13px;
    margin-right: var(--kb-s2);
    color: var(--kb-text-2);
}

.section-content {
    padding: var(--kb-s3);
    background-color: transparent;
}

.section-content--compact {
    padding: var(--kb-s2);
}

.section-content--flush {
    padding: 0;
}

.section-footer {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: transparent;
    border-top-width: 1px;
    border-top-color: var(--kb-line);
}

/* ===== Sub Section (inset well) ===== */
.sub-section {
    background-color: var(--kb-surface-2);
    border-radius: var(--kb-r-m);
    border-width: 0;
    padding: var(--kb-s3);
    margin-bottom: var(--kb-s3);
}

.sub-section-title {
    font-size: var(--kb-f-caption);
    -unity-font-style: bold;
    color: var(--kb-text-2);
    margin-bottom: var(--kb-s2);
}

/* ===== Info Box (semantic callouts) ===== */
.info-box {
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--kb-accent-soft);
    border-radius: var(--kb-r-m);
    border-width: 0;
    padding: var(--kb-s3);
    margin-bottom: var(--kb-s3);
}

.info-box-icon {
    font-size: 13px;
    color: var(--kb-accent);
    margin-right: var(--kb-s2);
    margin-top: 1px;
}

.info-box-text {
    flex-grow: 1;
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
    white-space: normal;
}

.info-box--success {
    background-color: var(--kb-ok-soft);
}

.info-box--success .info-box-icon {
    color: var(--kb-ok);
}

.info-box--warning {
    background-color: var(--kb-warn-soft);
}

.info-box--warning .info-box-icon {
    color: var(--kb-warn);
}

.info-box--error {
    background-color: var(--kb-bad-soft);
}

.info-box--error .info-box-icon {
    color: var(--kb-bad);
}

/* ===== Buttons ===== */
.btn-primary {
    height: 32px;
    font-size: var(--kb-f-body);
    -unity-font-style: bold;
    background-color: var(--kb-accent);
    color: var(--kb-on-accent);
    border-width: 0;
    border-radius: var(--kb-r-m);
    transition-duration: 0.1s;
}

.btn-primary:hover {
    background-color: var(--kb-accent-2);
}

.btn-primary:active {
    background-color: var(--kb-accent-2);
}

.btn-primary:disabled {
    background-color: var(--kb-surface-2);
    color: var(--kb-text-3);
}

.btn-secondary {
    height: 30px;
    background-color: var(--kb-surface-2);
    color: var(--kb-text);
    border-width: 0;
    border-radius: var(--kb-r-m);
    transition-duration: 0.1s;
}

.btn-secondary:hover {
    background-color: var(--kb-hover);
    color: var(--kb-text);
}

.btn-success {
    height: 30px;
    font-size: var(--kb-f-body);
    -unity-font-style: bold;
    background-color: var(--kb-ok-soft);
    color: var(--kb-ok);
    border-width: 0;
    border-radius: var(--kb-r-m);
    transition-duration: 0.1s;
}

.btn-success:hover {
    background-color: var(--kb-ok-soft);
    color: var(--kb-ok);
}

.btn-danger {
    height: 30px;
    font-size: var(--kb-f-body);
    -unity-font-style: bold;
    background-color: var(--kb-bad-soft);
    color: var(--kb-bad);
    border-width: 0;
    border-radius: var(--kb-r-m);
    transition-duration: 0.1s;
}

.btn-danger:hover {
    background-color: var(--kb-bad-soft);
    color: var(--kb-bad);
}

.btn-small {
    width: 24px;
    height: 24px;
    background-color: transparent;
    border-width: 0;
    border-radius: var(--kb-r-s);
}

.btn-small:hover {
    background-color: var(--kb-hover);
}

.helper-text-btn {
    background-color: transparent;
    border-width: 0;
    color: var(--kb-accent);
    margin-right: var(--kb-s2);
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: var(--kb-r-s);
}

.helper-text-btn:hover {
    color: var(--kb-accent);
    background-color: var(--kb-hover);
}

/* ===== Toolbar / Lists ===== */
.toolbar {
    flex-direction: row;
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    padding-top: var(--kb-s2);
    padding-bottom: var(--kb-s2);
    background-color: var(--kb-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
    align-items: center;
}

.toolbar-spacer {
    flex-grow: 1;
}

.log-view {
    flex-grow: 1;
    min-height: 150px;
    background-color: var(--kb-surface-2);
    padding: var(--kb-s2);
    border-width: 0;
    border-radius: var(--kb-r-m);
}

.log-info {
    color: var(--kb-text-2);
    margin-bottom: 2px;
    white-space: normal;
}

.log-ok {
    color: var(--kb-ok);
    margin-bottom: 2px;
    white-space: normal;
}

.log-warn {
    color: var(--kb-warn);
    margin-bottom: 2px;
    white-space: normal;
}

.log-bad {
    color: var(--kb-bad);
    margin-bottom: 2px;
    white-space: normal;
}

.asset-list {
    flex-grow: 1;
    min-height: 250px;
    background-color: var(--kb-surface);
    border-width: 1px;
    border-color: var(--kb-line);
    border-radius: var(--kb-r-m);
}

.list-item-row {
    flex-direction: row;
    align-items: center;
    padding-left: var(--kb-s2);
    padding-right: var(--kb-s2);
}

/* ===== Layout Helpers ===== */
.row {
    flex-direction: row;
}

.row-space-between {
    flex-direction: row;
    justify-content: space-between;
}

.row-center {
    flex-direction: row;
    align-items: center;
}

.flex-grow {
    flex-grow: 1;
}

.v-divider {
    width: 1px;
    background-color: var(--kb-line);
    align-self: stretch;
}

.col-divider {
    border-left-width: 1px;
    border-left-color: var(--kb-line);
}

/* ===== Text ===== */
.text-secondary {
    color: var(--kb-text-2);
}

.text-muted {
    color: var(--kb-text-3);
    font-size: var(--kb-f-caption);
}

.text-bold {
    -unity-font-style: bold;
}

.text-ok {
    color: var(--kb-ok);
}

.text-warn {
    color: var(--kb-warn);
}

.text-bad {
    color: var(--kb-bad);
}

.text-accent {
    color: var(--kb-accent);
}

.status-added {
    color: var(--kb-accent);
}

.status-removed {
    color: var(--kb-bad);
}

/* ===== Spacing Utilities ===== */
.mb-5 { margin-bottom: 5px; }
.mb-10 { margin-bottom: 10px; }
.mb-15 { margin-bottom: 15px; }
.mb-20 { margin-bottom: 20px; }
.mb-25 { margin-bottom: 25px; }
.mb-30 { margin-bottom: 30px; }

.mt-5 { margin-top: 5px; }
.mt-10 { margin-top: 10px; }
.mt-20 { margin-top: 20px; }
.mt-30 { margin-top: 30px; }

/* ===== Welcome Page ===== */
.welcome-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: var(--kb-s4);
    background-color: var(--kb-bg);
}

.welcome-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--kb-text);
    margin-bottom: var(--kb-s1);
}

.welcome-subtitle {
    font-size: var(--kb-f-body);
    color: var(--kb-text-2);
    margin-bottom: var(--kb-s4);
}

.feature-card {
    width: 230px;
    height: 84px;
    margin: var(--kb-s2);
    padding: var(--kb-s3);
    background-color: var(--kb-surface);
    border-left-width: 0;
    border-width: 1px;
    border-color: var(--kb-line);
    border-radius: var(--kb-r-l);
    transition-duration: 0.12s;
}

.feature-card:hover {
    background-color: var(--kb-hover);
    border-color: var(--kb-line-2);
}

.feature-card-title {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--kb-text);
}

.feature-card-desc {
    margin-top: 5px;
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
    white-space: normal;
}

/* ===== Scene Jump (in-page rows) ===== */
.scene-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: var(--kb-s2);
    padding-right: var(--kb-s2);
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
    transition-duration: 0.1s;
}

.scene-row:hover {
    background-color: var(--kb-hover);
}

/* ===== Symbols Page ===== */
.symbol-page-root {
    flex-direction: row;
    flex-grow: 1;
    padding: var(--kb-s3);
    background-color: var(--kb-bg);
}

.symbol-list-panel {
    width: 240px;
    min-width: 240px;
    background-color: var(--kb-surface);
    border-radius: var(--kb-r-l);
    border-width: 1px;
    border-color: var(--kb-line);
    margin-right: var(--kb-s3);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.symbol-list-header {
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    padding-top: 10px;
    padding-bottom: 10px;
    -unity-font-style: bold;
    font-size: var(--kb-f-caption);
    background-color: transparent;
    color: var(--kb-text-3);
    border-bottom-width: 1px;
    border-bottom-color: var(--kb-line);
}

.symbol-list-container {
    flex-grow: 1;
    padding: var(--kb-s2);
}

.symbol-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    margin-bottom: 3px;
    border-radius: var(--kb-r-m);
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    transition-duration: 0.1s;
}

.symbol-row:hover {
    background-color: var(--kb-hover);
    border-color: transparent;
}

.symbol-row--selected {
    background-color: var(--kb-accent-soft);
    border-color: var(--kb-accent-line);
}

.symbol-row--selected:hover {
    background-color: var(--kb-accent-soft);
}

.symbol-row--selected .symbol-row-label {
    color: var(--kb-accent);
    -unity-font-style: bold;
}

.symbol-row--selected .symbol-row-icon {
    color: var(--kb-accent);
}

.symbol-row-icon {
    font-size: 10px;
    margin-right: var(--kb-s2);
    color: var(--kb-text-3);
}

.symbol-row-icon--active {
    color: var(--kb-accent);
}

.symbol-row-label {
    flex-grow: 1;
    font-size: var(--kb-f-caption);
    color: var(--kb-text);
}

.symbol-empty-label {
    padding-left: var(--kb-s3);
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: var(--kb-f-caption);
    color: var(--kb-text-3);
    -unity-font-style: italic;
}

.symbol-list-footer {
    padding: 10px;
    background-color: transparent;
    border-top-width: 1px;
    border-top-color: var(--kb-line);
}

.symbol-detail-area {
    flex-grow: 1;
    padding: 0;
    background-color: transparent;
}

.symbol-detail-title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: var(--kb-s3);
    color: var(--kb-text);
}

.symbol-detail-desc {
    white-space: normal;
    color: var(--kb-text-2);
    font-size: var(--kb-f-body);
    margin-bottom: var(--kb-s4);
}

.symbol-status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--kb-s4);
}

/* ===== SelectionToCsv Page ===== */
.column-selection-container {
    margin-top: var(--kb-s3);
    margin-bottom: var(--kb-s3);
    background-color: var(--kb-surface);
    padding: var(--kb-s3);
    border-radius: var(--kb-r-m);
    border-width: 1px;
    border-color: var(--kb-line);
}

.column-toggle-btn {
    margin-right: 6px;
    margin-bottom: 6px;
    height: 26px;
    border-radius: 13px;
    background-color: var(--kb-surface-2);
    border-width: 0;
    color: var(--kb-text-2);
    transition-duration: 0.1s;
}

.column-toggle-btn:hover {
    background-color: var(--kb-hover);
    color: var(--kb-text);
}

.column-toggle-btn.active {
    background-color: var(--kb-accent);
    border-width: 0;
    color: var(--kb-on-accent);
    -unity-font-style: bold;
}

.column-toggle-btn.active:hover {
    background-color: var(--kb-accent-2);
    color: var(--kb-on-accent);
}

.helper-btn-row {
    flex-direction: row;
    margin-top: var(--kb-s2);
    border-top-width: 1px;
    border-top-color: var(--kb-line);
    padding-top: var(--kb-s2);
}

.options-row {
    flex-direction: row;
    margin-bottom: var(--kb-s3);
    padding-left: 5px;
}

.option-toggle {
    margin-right: 25px;
}

.asset-icon {
    width: 16px;
    height: 16px;
    margin-right: var(--kb-s2);
}

.asset-type-label {
    color: var(--kb-text-3);
    font-size: var(--kb-f-caption);
}

.browse-button {
    width: 70px;
}

/* ===== CSV Editor Page ===== */
.csv-scroll-view {
    flex-grow: 1;
    background-color: var(--kb-bg);
}

.csv-grid-container {
    padding: 2px;
}

.csv-row {
    flex-direction: row;
}

.csv-cell {
    width: 120px;
    margin: 0;
}

.csv-cell-header {
    -unity-font-style: bold;
    background-color: var(--kb-surface-2);
}

/* ===== Drag & Drop Overlay ===== */
.drag-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--kb-accent-soft);
    border-width: 2px;
    border-radius: var(--kb-r-l);
    border-color: var(--kb-accent);
    align-items: center;
    justify-content: center;
    display: none;
}

.drag-hint-text {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--kb-text);
    /* 主题无关的对比描边（token 豁免项） */
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.4);
}

/* ===== Input Fields ===== */
.unity-text-field > .unity-base-field__input,
.unity-integer-field > .unity-base-field__input,
.unity-float-field > .unity-base-field__input {
    background-color: var(--kb-surface-2);
    border-width: 1px;
    border-color: var(--kb-line);
    border-radius: var(--kb-r-s);
    color: var(--kb-text);
    padding-left: var(--kb-s2);
    padding-right: var(--kb-s2);
    padding-top: 4px;
    padding-bottom: 4px;
}

.unity-text-field > .unity-base-field__input:focus,
.unity-integer-field > .unity-base-field__input:focus,
.unity-float-field > .unity-base-field__input:focus {
    border-color: var(--kb-accent);
    background-color: var(--kb-bg);
}

.unity-enum-field > .unity-base-field__input {
    background-color: var(--kb-surface-2);
    border-width: 1px;
    border-color: var(--kb-line);
    border-radius: var(--kb-r-s);
    color: var(--kb-text);
}

.unity-enum-field > .unity-base-field__input:hover {
    border-color: var(--kb-line-2);
}

/* Toggle Checkbox */
.unity-toggle .unity-toggle__checkmark {
    background-color: var(--kb-surface-2);
    border-width: 1px;
    border-color: var(--kb-line-2);
    border-radius: 3px;
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--kb-accent);
    border-color: var(--kb-accent);
}

/* ===== Form ===== */
.form-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--kb-s3);
}

.form-label {
    width: 120px;
    min-width: 120px;
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
    -unity-text-align: middle-left;
}

.form-value {
    flex-grow: 1;
}

/* ===== Separator ===== */
.separator {
    height: 1px;
    background-color: var(--kb-line);
    margin-top: var(--kb-s3);
    margin-bottom: var(--kb-s3);
}

.separator--accent {
    height: 2px;
    background-color: var(--kb-accent);
}

/* ===== Button Row ===== */
.button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: var(--kb-s4);
}

.button-row > Button {
    margin-left: var(--kb-s2);
}

.button-row > Button.button-row-first {
    margin-left: 0;
}

/* ===== Stats Card ===== */
.stat-card {
    border-radius: var(--kb-r-m);
    border-color: var(--kb-line);
    padding: var(--kb-s4);
    min-width: 120px;
    align-items: center;
}

.stat-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--kb-accent);
    margin-bottom: var(--kb-s1);
}

.stat-label {
    font-size: var(--kb-f-caption);
    color: var(--kb-text-2);
}

/* ===== Page Section Container ===== */
.page-sections {
    padding: var(--kb-s4);
}

/* ===== Collapsible Section ===== */
.collapsible-header {
    flex-direction: row;
    align-items: center;
    padding-left: var(--kb-s3);
    padding-right: var(--kb-s3);
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: transparent;
    cursor: link;
}

.collapsible-header:hover {
    background-color: var(--kb-hover);
}

.collapsible-arrow {
    font-size: 10px;
    color: var(--kb-text-3);
    margin-right: var(--kb-s2);
    width: 12px;
    -unity-text-align: middle-center;
}

.collapsible-title {
    font-size: var(--kb-f-caption);
    -unity-font-style: bold;
    color: var(--kb-text);
    flex-grow: 1;
}

.collapsible-content {
    padding: var(--kb-s3);
    border-top-width: 1px;
    border-top-color: var(--kb-line);
}

/* ===== Mode Toggle (BatchRename segment) ===== */
.mode-toggle {
    flex-grow: 1;
    height: 26px;
    background-color: var(--kb-surface-2);
    border-width: 0;
    border-radius: var(--kb-r-s);
    color: var(--kb-text-2);
    font-size: var(--kb-f-caption);
    margin-right: 4px;
    transition-duration: 0.1s;
}

.mode-toggle:hover {
    background-color: var(--kb-hover);
    color: var(--kb-text);
}

.mode-toggle.active {
    background-color: var(--kb-accent);
    color: var(--kb-on-accent);
    -unity-font-style: bold;
}

.mode-toggle.active:hover {
    background-color: var(--kb-accent-2);
    color: var(--kb-on-accent);
}
